// ── Semantic checker ─────────────────────────────────────────────────────────
// Provides: TY_* type constants, sc_program(), sc_error_count, sc_errors[]
import "../parser/ast.ionic";         // ND_* node kinds, nd_* node tables
import "../diagnostics.ionic";        // print_span, diag_line_start/extract_line

// ── Type integer constants ───────────────────────────────────────────────────
let TY_VOID       = 0;
let TY_INT64      = 1;
let TY_FLOAT64    = 2;
let TY_BOOL       = 3;
let TY_STR        = 4;
let TY_ARRAY      = 5;
let TY_STRUCT     = 8;
let TY_TENSOR_CPU = 9;
let TY_TENSOR_GPU = 10;
let TY_MODEL_CPU  = 11;
let TY_MODEL_GPU  = 12;
let TY_UNKNOWN    = 13;

// ── Error collection ─────────────────────────────────────────────────────────
mut sc_errors      = [""];
mut sc_error_count = 0;
mut sc_active_node = 0;  // set by sc_expr/sc_stmt so errors know which node they're on

fn sc_error(string msg) -> int64 {
    sc_error_count = sc_error_count + 1;
    if (sc_error_count < len(sc_errors)) {
        sc_errors[sc_error_count] = msg;
    } else {
        push(sc_errors, msg);
    }
    return 0;
}

fn sc_error_at(string ctx, string msg) -> int64 {
    let line = nd_line[sc_active_node];
    let col  = nd_col[sc_active_node];
    let full = str_concat(ctx, str_concat(": ", msg));
    print_span(line, col, full);
    return sc_error(full);
}

// ── Type name helper ─────────────────────────────────────────────────────────
fn ty_name(int64 ty, string sv) -> string {
    if (ty == TY_VOID)       { return "void"; }
    if (ty == TY_INT64)      { return "int64"; }
    if (ty == TY_FLOAT64)    { return "float64"; }
    if (ty == TY_BOOL)       { return "bool"; }
    if (ty == TY_STR)        { return "string"; }
    if (ty == TY_ARRAY)      { return "array"; }
    if (ty == TY_STRUCT)     { return sv; }
    if (ty == TY_TENSOR_CPU) { return "tensor@cpu"; }
    if (ty == TY_TENSOR_GPU) { return "tensor@gpu"; }
    if (ty == TY_MODEL_CPU)  { return "model@cpu"; }
    if (ty == TY_MODEL_GPU)  { return "model@gpu"; }
    if (ty == TY_UNKNOWN)    { return "unknown"; }
    return "?";
}

// ── Node type-annotation → TY_* ──────────────────────────────────────────────
fn node_ty_to_int(int64 ty_node) -> int64 {
    let k = nd_kind[ty_node];
    if (k == ND_TY_INT64)   { return TY_INT64; }
    if (k == ND_TY_FLOAT64) { return TY_FLOAT64; }
    if (k == ND_TY_BOOL)    { return TY_BOOL; }
    if (k == ND_TY_STRING)  { return TY_STR; }
    if (k == ND_TY_VOID)    { return TY_VOID; }
    if (k == ND_TY_TENSOR)  {
        if (nd_iv[ty_node] == 1) { return TY_TENSOR_GPU; }
        return TY_TENSOR_CPU;
    }
    if (k == ND_TY_MODEL)   { return TY_MODEL_CPU; }
    if (k == ND_TY_ARRAY)   { return TY_ARRAY; }
    if (k == ND_TY_NAMED)   { return TY_STRUCT; }
    return TY_UNKNOWN;
}

fn node_ty_sv(int64 ty_node) -> string {
    if (nd_kind[ty_node] == ND_TY_NAMED) { return nd_sv[ty_node]; }
    return "";
}

// Return the element type of a `[...]` array type annotation node, or
// TY_UNKNOWN if ty_node is not an array type.
fn node_ty_elem_int(int64 ty_node) -> int64 {
    if (nd_kind[ty_node] != ND_TY_ARRAY) { return TY_UNKNOWN; }
    let inner = nd_i2[ty_node];
    if (inner == 0) { return TY_UNKNOWN; }
    return node_ty_to_int(inner);
}

// Encode an array element type as its sv-string form ("" means unknown).
fn elem_sv(int64 e) -> string {
    if (e == TY_UNKNOWN || e == TY_ARRAY || e == TY_STRUCT) { return ""; }
    return int64_to_str(e);
}

// Decode an array element type from its sv-string form ("" means unknown).
fn elem_from_sv(string sv) -> int64 {
    if (str_len(sv) == 0) { return TY_UNKNOWN; }
    let v = str_to_int64(sv);
    if (v == TY_INT64)   { return TY_INT64; }
    if (v == TY_FLOAT64) { return TY_FLOAT64; }
    if (v == TY_STR)     { return TY_STR; }
    if (v == TY_BOOL)    { return TY_BOOL; }
    // TY_VOID/TY_ARRAY as element types are not supported; treat as unknown.
    return TY_UNKNOWN;
}

// For an array type annotation node, produce the element-type sv-string.
fn node_ty_arr_elem_sv(int64 ty_node) -> string {
    if (nd_kind[ty_node] != ND_TY_ARRAY) { return ""; }
    return elem_sv(node_ty_elem_int(ty_node));
}

// The "sv value" of a type annotation used for declarations:
//   struct → struct name, array → element-type sv, otherwise "".
fn node_ty_val_sv(int64 ty_node) -> string {
    if (ty_node == 0) { return ""; }
    if (nd_kind[ty_node] == ND_TY_NAMED) { return nd_sv[ty_node]; }
    return node_ty_arr_elem_sv(ty_node);
}

// Element type (TY_*) of an array-literal AST node, by inspecting the first
// element's node kind. Used by the top-level globals pre-pass where
// sc_expr/sc_elem_ty are not yet available.
fn array_lit_elem_ty(int64 lit) -> int64 {
    let e = nd_i2[lit];
    if (e == 0) { return TY_UNKNOWN; }
    let en = nd_i2[e];
    if (en == 0) { return TY_UNKNOWN; }
    let k = nd_kind[en];
    if (k == ND_INT || k == ND_BOOL) { return TY_INT64; }
    if (k == ND_FLOAT)               { return TY_FLOAT64; }
    if (k == ND_STR)                 { return TY_STR; }
    return TY_UNKNOWN;
}

// types are compatible if they are equal or either is unknown
fn ty_compat(int64 got, int64 want) -> bool {
    if (want == TY_UNKNOWN || got == TY_UNKNOWN) { return true; }
    if (got == want) { return true; }
    // bool and int64 are the same at runtime
    if ((got == TY_BOOL || got == TY_INT64) && (want == TY_BOOL || want == TY_INT64)) { return true; }
    return false;
}

// ── Symbol table (scope stack with overwrite-or-extend) ───────────────────────
mut sv_names   = [""];
mut sv_tys     = [0];
mut sv_svs     = [""];  // struct name (TY_STRUCT) or elem type str (TY_ARRAY)
mut sv_muts    = [0];   // 0=let, 1=mut
// Static byte size of a value, or -1 when not knowable at compile time.
// This is the size channel the pool budget (stage B3/B4) is charged against; it
// is deliberately a separate column rather than folded into `sv_svs` (which
// already carries a struct name or an array element type).
//
// It must be kept current, including being set BACK to -1: a binding reassigned
// to a runtime-shaped value is no longer the size it was declared with, and a
// later `mlx_add(a, a)` that reads a stale size is charged for bytes it cannot
// know — which is how an unknown-size value turns into a false rejection.
mut sv_bytes   = [-1];
// Which budget scope this binding's bytes are currently counted in, or 0 when
// they are not counted anywhere.
//
// Reassignment releases the value a name holds before charging the new one, and
// "release" means subtracting from `sc_used_bytes`. That is only valid if the
// bytes were added to the *same* total: a nested `gpu { }` starts its running
// total at zero, so subtracting an enclosing scope's charge from it would
// under-count and let an over-budget program through. Recording the scope id
// makes the subtraction check that it is subtracting what it actually added.
mut sv_charged = [0];
// Where this binding was consumed by a transfer, or 0 if it still owns a value.
//
// A transfer is a MOVE: the value occupies exactly one pool, so after
// `let g = x.toGpu();` the SRAM binding `x` no longer owns anything and using it
// is a use-after-move (stage B5, decision 1). Capacity accounting is only
// meaningful if a value has a single owner — otherwise `x` and `g` would both
// count against their pools while naming the same bytes.
//
// The line (rather than a plain 0/1 flag) doubles as the provenance the
// diagnostic needs: a move error that cannot say *where* the value went is much
// harder to act on than one that can.
mut sv_mvline  = [0];
mut sv_mvhow   = [""];  // ".toGpu()" / ".toCpu()" — the transfer that consumed it
mut sv_count   = 0;
mut frame_stk  = [0];
mut frame_count = 0;

fn sv_push_frame() -> int64 {
    frame_count = frame_count + 1;
    if (frame_count < len(frame_stk)) {
        frame_stk[frame_count] = sv_count;
    } else {
        push(frame_stk, sv_count);
    }
    return 0;
}

fn sv_pop_frame() -> int64 {
    frame_count = frame_count - 1;
    sv_count = frame_stk[frame_count + 1];
    return 0;
}

fn sv_declare(string name, int64 ty, string sv, int64 mut_flag) -> int64 {
    sv_count = sv_count + 1;
    if (sv_count < len(sv_names)) {
        sv_names[sv_count]  = name;
        sv_tys[sv_count]    = ty;
        sv_svs[sv_count]    = sv;
        sv_muts[sv_count]   = mut_flag;
        sv_bytes[sv_count]  = -1;
        sv_charged[sv_count] = 0;
        sv_mvline[sv_count] = 0;
        sv_mvhow[sv_count]  = "";
    } else {
        push(sv_names,  name);
        push(sv_tys,    ty);
        push(sv_svs,    sv);
        push(sv_muts,   mut_flag);
        push(sv_bytes,  -1);
        push(sv_charged, 0);
        push(sv_mvline, 0);
        push(sv_mvhow,  "");
    }
    return 0;
}

// Mark the binding `name` as consumed by the transfer `how` written on `line`.
// A rebinding (`sv_declare`) clears the mark, which is what makes
// `let g = x.toGpu(); let x = mlx_ones(...);` legal — the old value was moved,
// the new one is a distinct value in a reused slot.
fn sv_mark_moved(string name, int64 line, string how) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return 0; }
    sv_mvline[i] = line;
    sv_mvhow[i]  = how;
    return 0;
}

// Line of the transfer that consumed `name`, or 0 if it still owns a value.
fn sv_moved_at(string name) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return 0; }
    return sv_mvline[i];
}

fn sv_moved_how(string name) -> string {
    let i = sv_lookup_idx(name);
    if (i == 0) { return ""; }
    return sv_mvhow[i];
}

// Record the static size of the most recent binding of `name`. Kept separate
// from sv_declare() because the size is not known until the initialiser has been
// sized, and because a re-binding must be able to update it.
fn sv_set_bytes(string name, int64 b) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return 0; }
    sv_bytes[i] = b;
    return 0;
}

fn sv_lookup_bytes(string name) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return -1; }
    return sv_bytes[i];
}

// Record that `name`'s bytes are now counted in budget scope `sid` (0 = not
// counted anywhere). Called by budget_charge on both paths, and read back by
// sv_release_charge.
fn sv_charged_in_set(string name, int64 sid) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return 0; }
    sv_charged[i] = sid;
    return 0;
}

// Release `name`'s charge from the current scope's running total, if this scope
// is where it was charged.
//
// Called before a binding is reassigned or re-declared in the same slot. The
// scope check is what makes it safe: a nested `gpu { }` starts its total at zero,
// so releasing an enclosing scope's bytes from it would drive the total below
// what this scope actually holds and let an over-budget body through. When the
// charge belongs to another scope, this scope never counted it and has nothing
// to release.
fn sv_release_charge(string name) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return 0; }
    if (sv_charged[i] == 0 || sv_charged[i] != sc_scope_id) { return 0; }
    if (sv_bytes[i] > 0) { sc_used_bytes = sc_used_bytes - sv_bytes[i]; }
    sv_charged[i] = 0;
    return 0;
}

fn sv_lookup_idx(string name) -> int64 {
    mut i = sv_count;
    while (i >= 1) {
        if (str_eq(sv_names[i], name)) { return i; }
        i = i - 1;
    }
    return 0;
}

fn sv_lookup_ty(string name) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return TY_UNKNOWN; }
    return sv_tys[i];
}

fn sv_lookup_sv_val(string name) -> string {
    let i = sv_lookup_idx(name);
    if (i == 0) { return ""; }
    return sv_svs[i];
}

fn sv_lookup_mut(string name) -> int64 {
    let i = sv_lookup_idx(name);
    if (i == 0) { return 0; }
    return sv_muts[i];
}

fn sv_is_defined(string name) -> bool {
    return sv_lookup_idx(name) != 0;
}

// ── Struct registry ────────────────────────────────────────────────────────────
mut st_names  = [""];
mut st_sizes  = [0];
mut st_starts = [0];
mut st_count  = 0;
mut stf_names = [""];
mut stf_tys   = [0];
mut stf_svs   = [""];
mut stf_count = 0;

fn st_find(string name) -> int64 {
    mut i = 1;
    while (i <= st_count) {
        if (str_eq(st_names[i], name)) { return i; }
        i = i + 1;
    }
    return 0;
}

fn st_field_ty(int64 st_idx, string field) -> int64 {
    if (st_idx == 0) { return TY_UNKNOWN; }
    let start = st_starts[st_idx];
    let sz    = st_sizes[st_idx];
    mut i = start;
    while (i < start + sz) {
        if (str_eq(stf_names[i], field)) { return stf_tys[i]; }
        i = i + 1;
    }
    return TY_UNKNOWN;
}

fn st_field_sv(int64 st_idx, string field) -> string {
    if (st_idx == 0) { return ""; }
    let start = st_starts[st_idx];
    let sz    = st_sizes[st_idx];
    mut i = start;
    while (i < start + sz) {
        if (str_eq(stf_names[i], field)) { return stf_svs[i]; }
        i = i + 1;
    }
    return "";
}

fn st_field_offset(int64 st_idx, string field) -> int64 {
    if (st_idx == 0) { return -1; }
    let start = st_starts[st_idx];
    let sz    = st_sizes[st_idx];
    mut i = 0;
    while (i < sz) {
        if (str_eq(stf_names[start + i], field)) { return i; }
        i = i + 1;
    }
    return -1;
}

// ── Function registry ──────────────────────────────────────────────────────────
mut fn_names   = [""];
mut fn_ret_tys = [0];
mut fn_ret_svs = [""];
mut fn_pcounts = [0];
mut fn_pstarts = [0];
mut fn_hws     = [0];   // hw annotation node per fn (0 = none) — for @cpu/@gpu checks
mut fn_is_builtin = [0]; // 1 for registered builtins, 0 for user functions
mut fn_pool_poly = [0];  // 1 = result pool is inferred from the first tensor arg
mut fn_count   = 0;
// Flat param table
mut fp_tys   = [0];
mut fp_svs   = [""];
mut fp_count = 0;
// Parallel to fp_tys: 1 when the parameter accepts a tensor of *any* placement.
//
// Builtins are the operations of the pool model, so they must work on whichever
// pool their operands live in — `mlx_add(gpu_a, gpu_b)` is the whole reason
// `tensor@gpu` exists. User functions are different: a `@cpu fn(tensor@cpu x)`
// is a promise about where the work happens, and violating it is the error
// placement types exist to catch. Keeping the two kinds of call apart is what
// preserves `examples/mastery/fail/tensor_mismatch.ionic`.
//
// This is deliberately NOT folded into `ty_compat`, which stays strict for
// every call. Only the builtin argument check consults this table.
mut fp_anyplace = [0];

fn fn_find(string name) -> int64 {
    mut i = 1;
    while (i <= fn_count) {
        if (str_eq(fn_names[i], name)) { return i; }
        i = i + 1;
    }
    return 0;
}

fn fn_ret_ty(string name) -> int64 {
    let i = fn_find(name);
    if (i == 0) { return TY_UNKNOWN; }
    return fn_ret_tys[i];
}

fn fn_ret_sv(string name) -> string {
    let i = fn_find(name);
    if (i == 0) { return ""; }
    return fn_ret_svs[i];
}

fn fn_pcount(string name) -> int64 {
    let i = fn_find(name);
    if (i == 0) { return -1; }
    return fn_pcounts[i];
}

fn fn_param_ty(string name, int64 param_idx) -> int64 {
    let fi = fn_find(name);
    if (fi == 0) { return TY_UNKNOWN; }
    let base = fn_pstarts[fi];
    return fp_tys[base + param_idx - 1];
}

fn fn_param_sv(string name, int64 param_idx) -> string {
    let fi = fn_find(name);
    if (fi == 0) { return ""; }
    let base = fn_pstarts[fi];
    return fp_svs[base + param_idx - 1];
}

// ── "Did you mean…?" suggestion engine ────────────────────────────────────────
// Computes Levenshtein edit distance between two short identifier strings
// and picks the closest registered name within a small threshold. Used by
// the checker to attach a `help:` line to "unknown function / variable /
// struct" diagnostics so the user doesn't have to eyeball typos.
//
// Pools are scanned linearly — name registries are small (<200 entries in
// real code) so O(N) per suggestion is fine.

fn lev_min3(int64 a, int64 b, int64 c) -> int64 {
    mut m = a;
    if (b < m) { m = b; }
    if (c < m) { m = c; }
    return m;
}

// Levenshtein edit distance between two strings. Classic O(m·n) DP using
// two rolling rows (no 2D arrays in this language). Returns the count.
fn lev_distance(string a, string b) -> int64 {
    let la = str_len(a);
    let lb = str_len(b);
    if (la == 0) { return lb; }
    if (lb == 0) { return la; }
    // prev_row[i] = distance between a[0..i] and "" — just i (all deletions).
    mut prev_row = [0]; arr_reset(prev_row);
    mut curr_row = [0]; arr_reset(curr_row);
    mut i = 0;
    while (i <= lb) { prev_row.push(i); i = i + 1; }
    mut ia = 0;
    while (ia < la) {
        // curr_row[0] = distance between "" and a[0..ia+1] — all insertions = ia+1.
        arr_reset(curr_row);
        curr_row.push(ia + 1);
        let ac = str_index(a, ia);
        mut ib = 0;
        while (ib < lb) {
            let bc = str_index(b, ib);
            mut cost = 1;
            if (ac == bc) { cost = 0; }
            let del = prev_row[ib + 1] + 1;
            let ins = curr_row[ib] + 1;
            let sub = prev_row[ib] + cost;
            curr_row.push(lev_min3(del, ins, sub));
            ib = ib + 1;
        }
        // Swap rows.
        mut tmp = prev_row;
        prev_row = curr_row;
        curr_row = tmp;
        ia = ia + 1;
    }
    return prev_row[lb];
}

// Should `candidate` be suggested for `bad`? Threshold:
//   - always if edits <= 2 and both names are >= 3 chars
//   - otherwise allow up to ceil(len/3) edits (catches "foo" → "fooo")
fn lev_is_close_enough(string bad, string candidate) -> int64 {
    let d = lev_distance(bad, candidate);
    if (d <= 2) {
        if (str_len(bad) >= 3 && str_len(candidate) >= 3) { return 1; }
    }
    let lb = str_len(bad);
    let lc = str_len(candidate);
    mut max_len = lb;
    if (lc > max_len) { max_len = lc; }
    let limit = (max_len + 2) / 3;   // ceil(max_len / 3)
    if (d <= limit) { return 1; }
    return 0;
}

// Scan a [string] pool (1-based, length = n) and return the best suggestion
// for `bad`. Returns "" if nothing is close enough.
fn suggest_from_pool([string] pool, int64 n, string bad) -> string {
    if (n <= 0) { return ""; }
    mut best_name = "";
    mut best_dist = 999999;
    mut i = 1;
    while (i <= n) {
        let cand = pool[i];
        if (str_eq(cand, bad)) {
            // Exact match means we're in the wrong pool — don't suggest.
            i = i + 1;
        } else {
            if (lev_is_close_enough(bad, cand) == 1) {
                let d = lev_distance(bad, cand);
                if (d < best_dist) {
                    best_dist = d;
                    best_name = cand;
                }
            }
            i = i + 1;
        }
    }
    return best_name;
}

// Convenience: suggest a similar function name.
fn suggest_fn(string bad) -> string {
    return suggest_from_pool(fn_names, fn_count, bad);
}

// Convenience: suggest a similar variable name.
fn suggest_var(string bad) -> string {
    return suggest_from_pool(sv_names, sc_symbol_count(), bad);
}

// Convenience: suggest a similar struct name.
fn suggest_struct(string bad) -> string {
    return suggest_from_pool(st_names, st_count, bad);
}

// Number of registered variables (sv_names / sv_tys share a flat layout).
// Computed lazily: the registry is built via sv_def() which always pushes;
// we walk to find the actual count by checking for the empty sentinel.
fn sc_symbol_count() -> int64 {
    let n = len(sv_names);
    if (n == 0) { return 0; }
    return n - 1;   // sv_names has a sentinel at [0]
}

// Emit a "did you mean X?" hint line after the active diagnostic.
// Walks to a fresh line (no source-line reprint) and prints in a Rust-style
// "help:" prefix that doesn't bump sc_error_count (it's a hint, not an error).
// When colors are enabled (terminal output), the suggestion name pops in
// green so the eye lands on it; everything else stays dim.
fn sc_hint_did_you_mean(string what, string suggestion) -> int64 {
    if (str_eq(suggestion, "")) { return 0; }
    color_autodetect();
    let tag     = color_wrap(ANSI_BOLD_CYAN, "    help:");
    let sugg    = color_wrap(ANSI_BOLD_GREEN, str_concat("'", str_concat(suggestion, "'")));
    let suffix  = color_wrap(ANSI_DIM, str_concat("(similar ", str_concat(what, ")?")));
    println(str_concat(str_concat(str_concat(tag, " did you mean "), sugg),
            str_concat(" ", suffix)));
    return 0;
}

// ── Current function context for return-type checking ─────────────────────────
mut sc_cur_fn_ret_ty = 0;
mut sc_cur_fn_ret_sv = "";
mut sc_cur_fn_name   = "";
mut sc_in_gpu_block  = 0;
mut sc_in_conversion = 0;   // 1 while evaluating .toGpu()/.toCpu() operand

// ── GPU/tensor helpers ────────────────────────────────────────────────────────
fn is_tensor_ty(int64 ty) -> bool {
    return ty == TY_TENSOR_CPU || ty == TY_TENSOR_GPU;
}

fn tensor_convert_hint(int64 got, int64 want) -> string {
    if (got == TY_TENSOR_CPU && want == TY_TENSOR_GPU) { return " (call .toGpu() to convert)"; }
    if (got == TY_TENSOR_GPU && want == TY_TENSOR_CPU) { return " (call .toCpu() to convert)"; }
    // Numeric types are NOT implicitly widened. `sqrt(4)` is not sqrt of four:
    // float parameters travel as raw IEEE-754 bit patterns in general-purpose
    // registers (see ionic_model_runtime.c — every float builtin takes
    // int64_t and converts with i642d), so an integer argument is reinterpreted
    // as a denormal near zero and the program silently returns the wrong
    // answer. Rejecting it is the only safe choice; the fix is one call away.
    if ((got == TY_INT64 || got == TY_BOOL) && want == TY_FLOAT64) {
        return " (write 4.0, or convert with int64_to_float64(n))";
    }
    if (got == TY_FLOAT64 && (want == TY_INT64 || want == TY_BOOL)) {
        return " (convert with float64_to_int64(x))";
    }
    return "";
}

// hw_node is an ND_HW annotation node (from @gpu / @cpu / @gpu(f) / @cpu(f)),
// or 0 when the declaration carried no placement annotation.
fn hw_ann_is_gpu(int64 hw_node) -> bool {
    if (hw_node == 0) { return false; }
    let v = nd_iv[hw_node];
    return v == HW_GPU || v == HW_GPU_FRAC;
}

fn hw_ann_is_cpu(int64 hw_node) -> bool {
    if (hw_node == 0) { return false; }
    let v = nd_iv[hw_node];
    return v == HW_CPU || v == HW_CPU_FRAC;
}

fn hw_ann_name(int64 hw_node) -> string {
    if (hw_ann_is_gpu(hw_node)) { return "@gpu"; }
    if (hw_ann_is_cpu(hw_node)) { return "@cpu"; }
    return "";
}

// Emit a warning at `node`'s position. Not an error: sc_error_count is
// untouched, so a program that only warns still compiles, links, and runs.
fn sc_warn_at(int64 node, string msg) -> int64 {
    if (node == 0) { println(str_concat("[warn] ", msg)); return 0; }
    print_span_warn(nd_line[node], nd_col[node], msg);
    return 0;
}

// ── Memory-pool budget (Stage B2) ────────────────────────────────────────────
//
// `@cpu` / `@gpu` name *memory pools*, not devices: SRAM (host memory) and VRAM
// (accelerator memory). The pools have different capacities, and VRAM is the
// scarce one, so the interesting failure is not "wrong device" but "did not
// fit". The pool size is a deployment fact — which card is installed — so it is
// declared ONCE at top level and inherited by every @gpu scope:
//
//     let vram = 25769803776;             // bytes of accelerator memory
//     @gpu fn train_step(...) -> ... {}   // may use up to the whole pool
//     @gpu(0.25) fn helper(...) -> ... {} // may use up to a quarter of it
//
// The name is a convention the checker recognises, not a language keyword: it is
// an ordinary top-level `let`, so it costs no new syntax and the value is
// readable at runtime like any other global.
let POOL_DECL_NAME = "vram";

// Declared pool size in bytes, or 0 when the program declares none.
// 0 is not an error by itself — a program that never restricts a GPU scope does
// not need a pool. It only becomes an error when a `@gpu(f)` fraction is
// applied, because a fraction of an undeclared pool is meaningless.
mut pool_vram_bytes = 0;
// How many top-level declarations of the pool name were seen, so a second one
// is reported rather than silently taking the last value.
mut pool_decl_count = 0;

// Bits of the largest fraction we accept. 1.0 as IEEE-754 double. Comparing
// bit patterns is exact for positives and avoids doing float arithmetic in the
// checker: every positive double's bit pattern is monotonic in its value, so
// `0 < bits <= bits(1.0)` is exactly `0 < f <= 1.0`.
let FRAC_ONE_BITS = 4607182418800017408;

// Parse the fraction text carried by an ND_HW node. Returns -1 when the node is
// absent or carries no fraction, 0 when the text is not a positive number <= 1.
fn hw_frac_bits(int64 hw_node) -> int64 {
    if (hw_node == 0) { return -1; }
    let v = nd_iv[hw_node];
    if (v != HW_GPU_FRAC && v != HW_CPU_FRAC) { return -1; }
    let txt = nd_sv[hw_node];
    if (str_len(txt) == 0) { return -1; }
    return str_to_float64_bits(txt);
}

// True when the fraction is a usable share of a pool: strictly positive and at
// most the whole pool. A fraction outside that range cannot describe a budget,
// so it is rejected where it is written rather than at some later use.
fn hw_frac_is_valid(int64 bits) -> bool {
    if (bits <= 0) { return false; }
    return bits <= FRAC_ONE_BITS;
}

// ── The fraction as an exact integer ratio (Stage B4) ────────────────────────
//
// The checker works in int64 throughout, so the fraction is carried as
// num/den (e.g. "0.25" -> 25/100) and the scope budget is
//
//     budget = pool_vram_bytes * num / den
//
// computed in integers. Multiplying first and dividing second keeps the result
// exact whenever the pool divides evenly, which is the common case (a 24 GiB
// pool, a quarter share). Fraction arithmetic in float64 would be one
// rounding error away from reporting a budget the user did not write.

fn frac_dot_pos(string s) -> int64 {
    mut i = 0;
    let n = str_len(s);
    while (i < n) {
        if (str_index(s, i) == 46) { return i; }   // 46 = '.'
        i = i + 1;
    }
    return -1;
}

// "0.25" -> 25, "1" -> 1, "1.0" -> 10
fn frac_num(string s) -> int64 {
    let dot = frac_dot_pos(s);
    if (dot < 0) { return str_to_int64(s); }
    let a = str_slice(s, 0, dot);
    let b = str_slice(s, dot + 1, str_len(s));
    return str_to_int64(str_concat(a, b));
}

// "0.25" -> 100, "1" -> 1, "1.0" -> 10
fn frac_den(string s) -> int64 {
    let dot = frac_dot_pos(s);
    if (dot < 0) { return 1; }
    let places = str_len(s) - dot - 1;
    mut d = 1;
    mut i = 0;
    while (i < places) { d = d * 10; i = i + 1; }
    return d;
}

// The byte budget of a scope whose annotation is `hw_node`, or -1 when there is
// nothing to check against (no pool declared). An unannotated fraction is the
// whole pool, i.e. num/den = 1/1.
fn scope_budget_bytes(int64 hw_node) -> int64 {
    if (pool_vram_bytes <= 0) { return -1; }
    let fb = hw_frac_bits(hw_node);
    if (fb == -1) { return pool_vram_bytes; }
    if (!hw_frac_is_valid(fb)) { return -1; }   // already reported by B2
    let txt = nd_sv[hw_node];
    let den = frac_den(txt);
    if (den <= 0) { return -1; }
    return pool_vram_bytes * frac_num(txt) / den;
}

// ── Static tensor sizes (Stage B3) ──────────────────────────────────────────
//
// A tensor's size is product(shape) x dtype_size. Both are knowable for the
// constructor builtins, which is where VRAM actually gets allocated, so those
// are what this models. Everything else reports "unknown" (-1) rather than
// guessing.
//
// Sizes are the currency of the budget check: a `tensor@gpu` whose size is
// unknown is not counted, and not rejected either — see the COVERAGE note on
// budget_charge() below.

// Bytes per element for an IonicDtype code (mirrors ionic_model_runtime.c).
fn dtype_bytes(int64 dt) -> int64 {
    if (dt == 0) { return 4; }   // F32 (the default when unspecified)
    if (dt == 1) { return 2; }   // F16
    if (dt == 2) { return 2; }   // BF16
    if (dt == 3) { return 8; }   // F64
    if (dt == 4) { return 4; }   // I32
    if (dt == 5) { return 8; }   // I64
    if (dt == 6) { return 1; }   // BOOL
    if (dt == 7) { return 1; }   // U8
    return -1;
}

// nth argument node (1-based) of a call, or 0 when there is no such argument.
fn arg_node(int64 args, int64 n) -> int64 {
    mut cur = args;
    mut i = 1;
    while (cur != 0) {
        if (i == n) { return nd_i2[cur]; }
        i = i + 1;
        cur = nd_i3[cur];
    }
    return 0;
}

// Element count of an `[a, b, c]` shape literal, or -1 unless every element is
// a non-negative integer literal. A shape built at runtime is not static.
fn shape_lit_count(int64 lit) -> int64 {
    if (lit == 0) { return -1; }
    if (nd_kind[lit] != ND_ARRAY_LIT) { return -1; }
    mut cur = nd_i2[lit];
    mut n = 0;
    mut prod = 1;
    while (cur != 0) {
        let e = nd_i2[cur];
        if (nd_kind[e] != ND_INT) { return -1; }
        if (nd_iv[e] < 0) { return -1; }
        prod = prod * nd_iv[e];
        n = n + 1;
        cur = nd_i3[cur];
    }
    if (n == 0) { return -1; }
    return prod;
}

// `shape_lit_count x dtype_bytes`, or -1 if either is unknown.
fn bytes_of_shape(int64 shape_node, int64 dtype_node) -> int64 {
    let n = shape_lit_count(shape_node);
    if (n < 0) { return -1; }
    if (dtype_node == 0) { return -1; }
    if (nd_kind[dtype_node] != ND_INT) { return -1; }
    let es = dtype_bytes(nd_iv[dtype_node]);
    if (es < 0) { return -1; }
    return n * es;
}

// Static size in bytes of `node`, or -1 when not knowable at compile time.
fn expr_bytes(int64 node) -> int64 {
    if (node == 0) { return -1; }
    let k = nd_kind[node];

    // A transfer moves bytes between pools; it does not change how many.
    if (k == ND_TO_GPU || k == ND_TO_CPU) { return expr_bytes(nd_i2[node]); }

    if (k == ND_IDENT) { return sv_lookup_bytes(nd_sv[node]); }

    if (k == ND_METHOD_CALL) {
        let m = nd_sv[node];
        if (str_eq(m, "toGpu") || str_eq(m, "toCpu")) { return expr_bytes(nd_i2[node]); }
        return -1;
    }

    if (k == ND_CALL) {
        let callee = nd_sv[node];
        let args   = nd_i2[node];

        // Constructors: (shape, dtype)
        if (str_eq(callee, "mlx_zeros") || str_eq(callee, "mlx_ones")) {
            return bytes_of_shape(arg_node(args, 1), arg_node(args, 2));
        }
        // mlx_full(shape, value, dtype)
        if (str_eq(callee, "mlx_full")) {
            return bytes_of_shape(arg_node(args, 1), arg_node(args, 3));
        }
        // mlx_random_normal(shape, loc, scale, dtype) / _uniform(shape, lo, hi, dtype)
        if (str_eq(callee, "mlx_random_normal") || str_eq(callee, "mlx_random_uniform")) {
            return bytes_of_shape(arg_node(args, 1), arg_node(args, 4));
        }
        // mlx_eye(n, m, dtype)
        if (str_eq(callee, "mlx_eye")) {
            let n_nd = arg_node(args, 1);
            let m_nd = arg_node(args, 2);
            let d_nd = arg_node(args, 3);
            if (n_nd == 0 || m_nd == 0 || d_nd == 0) { return -1; }
            if (nd_kind[n_nd] != ND_INT || nd_kind[m_nd] != ND_INT) { return -1; }
            if (nd_kind[d_nd] != ND_INT) { return -1; }
            let es = dtype_bytes(nd_iv[d_nd]);
            if (es < 0 || nd_iv[n_nd] < 0 || nd_iv[m_nd] < 0) { return -1; }
            return nd_iv[n_nd] * nd_iv[m_nd] * es;
        }

        // Shape-preserving ops: the result occupies what the first operand does.
        if (str_eq(callee, "mlx_add")       || str_eq(callee, "mlx_subtract") ||
            str_eq(callee, "mlx_multiply")  || str_eq(callee, "mlx_divide")   ||
            str_eq(callee, "mlx_power")     || str_eq(callee, "mlx_maximum")  ||
            str_eq(callee, "mlx_minimum")   || str_eq(callee, "mlx_matmul")   ||
            str_eq(callee, "mlx_negative")  || str_eq(callee, "mlx_square")   ||
            str_eq(callee, "mlx_sqrt")      || str_eq(callee, "mlx_exp")      ||
            str_eq(callee, "mlx_log")       || str_eq(callee, "mlx_abs")      ||
            str_eq(callee, "mlx_tanh")      || str_eq(callee, "mlx_erf")      ||
            str_eq(callee, "mlx_contiguous")) {
            return expr_bytes(arg_node(args, 1));
        }

        // Reductions, reshapes, casts, slices and concatenation change the
        // shape (or the dtype) in ways this pass does not model.
        return -1;
    }

    return -1;
}

// ── Scope budget accumulation (Stage B4) ────────────────────────────────────
//
// Within one GPU scope, the values that occupy VRAM simultaneously must fit the
// scope's share of the pool. `sc_used_bytes` accumulates what the checker can
// size statically; the check fires at the declaration that pushes it over, so
// the diagnostic names the allocation responsible.
//
// COVERAGE — read before trusting this:
//   * It counts `let`-bound `tensor@gpu` locals whose size is statically known.
//   * It does NOT count values whose size is unknown (a parameter received from
//     the caller, or the result of an op this pass does not model). Those are
//     exempt rather than rejected: a parameter was allocated — and charged — in
//     the caller's scope, and rejecting every function that takes a tensor would
//     make the feature unusable. Decision 4 in the plan ("reject unbounded") is
//     therefore applied only where a value is *created* in a budgeted scope;
//     see the note in docs/plan-placement.md.
//   * Consequently this is a NECESSARY but not sufficient check: it catches
//     "I allocated 4 GiB against a 1% budget", and it does not prove that every
//     value in the scope fits. It under-approximates; it cannot produce a false
//     rejection.
mut sc_budget_bytes  = -1;   // -1 = no budget in force
mut sc_used_bytes    = 0;
// Unique id for the scope currently accumulating, so a binding can record which
// scope its bytes were added to. Incremented by budget_begin, which is why an
// id is never reused and a stale record cannot match a later scope.
mut sc_scope_id      = 0;
// Exempted GPU locals. `sc_unknown_count` is how many the scope produced;
// `sc_unknown_first` is the node of the first one, so the warning can point at
// a concrete line instead of making the user hunt for every GPU value in the
// scope. Only the first is remembered: one warning naming one real line is
// actionable, and the fix is the same for all of them.
mut sc_unknown_count = 0;
mut sc_unknown_first = 0;

// Start a budget for a scope. Returns nothing; sc_budget_bytes/sc_used_bytes are
// saved and restored by the caller.
fn budget_begin(int64 hw_node) -> int64 {
    sc_scope_id      = sc_scope_id + 1;
    sc_budget_bytes  = scope_budget_bytes(hw_node);
    sc_used_bytes    = 0;
    sc_unknown_count = 0;
    sc_unknown_first = 0;
    return 0;
}

// Charge one GPU-resident declaration. `name` is the binding, `init_nd` its
// initialiser, `node` the declaration node (for the diagnostic position).
//
// Both paths must leave the binding's size record correct, because a later
// `mlx_add(a, a)` is sized from it. Recording a size on the sized path and
// leaving the old one in place on the exempt path is what turned an unknown
// value into a false rejection: `a = mlx_reshape(a, [n, n])` kept `a`'s old
// byte count, so every derived value was charged bytes `a` no longer provably
// had.
fn budget_charge(string name, int64 init_nd, int64 node) -> int64 {
    if (sc_budget_bytes < 0) { return 0; }
    let b = expr_bytes(init_nd);
    if (b < 0) {
        // Exempt: the new value's size is unknown, so the record must say so.
        sv_set_bytes(name, -1);
        sv_charged_in_set(name, 0);
        sc_unknown_count = sc_unknown_count + 1;
        if (sc_unknown_first == 0) { sc_unknown_first = node; }
        return 0;
    }
    sv_set_bytes(name, b);
    sv_charged_in_set(name, sc_scope_id);
    sc_used_bytes = sc_used_bytes + b;
    if (sc_used_bytes > sc_budget_bytes) {
        sc_active_node = node;
        sc_error_at(str_concat("'" , str_concat(name, "' does not fit the accelerator pool")),
            str_concat(str_concat(str_concat(int64_to_str(b), " bytes here; "),
                                  str_concat(int64_to_str(sc_used_bytes), " bytes live in this scope")),
                       str_concat(str_concat(", budget is ", int64_to_str(sc_budget_bytes)),
                                  " (raise the `vram` pool or narrow the scope's fraction)")));
    }
    return 0;
}

// Report the values a budgeted scope could not size, then the caller restores
// the enclosing scope's budget.
//
// The budget check exempts a value whose size it cannot determine, and that
// exemption used to be invisible: `mlx_zeros([n, n], 0).toGpu()` in a budgeted
// scope compiled with no diagnostic, so "this fits" and "this was never
// measured" looked identical. A warning — not an error — makes the difference
// visible while keeping the compile succeeding, because an unbounded value is
// not provably wrong.
//
// Silent when the scope had a budget that covers everything and nothing was
// exempted, so a clean program stays clean.
fn budget_end() -> int64 {
    if (sc_budget_bytes >= 0 && sc_unknown_count > 0) {
        // "1 GPU value(s)" reads like an unrendered template, so the plural and
        // singular forms are written out. The language has no conditional
        // expression, hence the assignment-then-override. The pronoun moves with
        // the count for the same reason.
        mut head = str_concat(int64_to_str(sc_unknown_count), " GPU values in this scope could not be sized statically");
        mut pron = "them";
        if (sc_unknown_count == 1) {
            head = "1 GPU value in this scope could not be sized statically";
            pron = "it";
        }
        // Two wordings for the total, because "the 0 bytes it could size" is
        // noise when the scope held nothing sizeable at all.
        mut known = str_concat(str_concat(" (nothing in this scope could be sized, against a ",
                                          int64_to_str(sc_budget_bytes)),
                               " byte budget)");
        if (sc_used_bytes > 0) {
            known = str_concat(str_concat(" (the ", int64_to_str(sc_used_bytes)),
                               str_concat(" bytes it could size are only the known total, of a ",
                                          str_concat(int64_to_str(sc_budget_bytes), " byte budget)")));
        }
        let fix   = str_concat(str_concat(" — give ", pron), " a literal shape, or check mlx_pool_bytes() at run time");
        sc_warn_at(sc_unknown_first,
            str_concat(head, str_concat(str_concat(str_concat(", so the budget does not account for ", pron), known), fix)));
    }
    return 0;
}

// ── Transfers move: use-after-move (Stage B5) ────────────────────────────────
//
// `x.toGpu()` consumes `x`. Every other operation *borrows*: `mlx_add(g, g)`
// reads `g` twice and leaves it owned, `return x` hands over a copy of the
// handle. Only a transfer changes which binding owns the value, and only a
// transfer can strand one.
//
// The asymmetry matters. If builtin calls consumed their operands too, then
// `mlx_add(g, g)` would be illegal and every expression would need a copy of its
// inputs — which is not how the runtime works (MLX arrays are refcounted
// handles) and not what capacity accounting needs. What accounting needs is one
// owner per value, and transferring is the one operation that reassigns it.

// Reject a reference to a binding a previous transfer consumed.
fn sc_check_not_moved(string name) -> int64 {
    let at = sv_moved_at(name);
    if (at == 0) { return 0; }
    let how = sv_moved_how(name);
    sc_error_at(str_concat("use after move of '", str_concat(name, "'")),
        str_concat(str_concat(str_concat(str_concat("consumed by `", name), how),
                              str_concat("` on line ", int64_to_str(at))),
                   " (a transfer moves the value; bind the result and use that)"));
    return 0;
}

// Consume `name` at `line` on behalf of the transfer `how`. Idempotent: a second
// transfer of an already-moved value is reported by sc_check_not_moved(), not
// here, so the first move's provenance is what the diagnostic keeps.
fn sc_move_binding(string name, int64 line, string how) -> int64 {
    if (!sv_is_defined(name)) { return 0; }
    if (sv_moved_at(name) != 0) { return 0; }
    sv_mark_moved(name, line, how);
    return 0;
}

// Apply the transfer rule to a `.toGpu()` / `.toCpu()` operand: the operand may
// itself be a transfer (`a.toCpu().toGpu()` moves `a` once, through the inner
// call), and a temporary has no binding to consume.
fn sc_consume_operand(int64 operand, int64 line, string how) -> int64 {
    if (operand == 0) { return 0; }
    let k = nd_kind[operand];
    if (k == ND_IDENT) {
        sc_move_binding(nd_sv[operand], line, how);
        return 0;
    }
    if (k == ND_TO_GPU || k == ND_TO_CPU) {
        // The inner transfer already consumed whatever it was given; the outer
        // one consumes the temporary it produced.
        return 0;
    }
    return 0;
}

// Functions that access CPU state and are banned inside gpu {} blocks
fn is_cpu_only_fn(string name) -> bool {
    if (str_eq(name, "print"))          { return true; }
    if (str_eq(name, "file_read"))      { return true; }
    if (str_eq(name, "file_write"))     { return true; }
    if (str_eq(name, "get_arg"))        { return true; }
    if (str_eq(name, "cpu_core_count")) { return true; }
    return false;
}

// ── sc_expr result globals ────────────────────────────────────────────────────
mut sc_ty      = 0;
mut sc_sv      = "";
mut sc_elem_ty = 0;

// ── Struct pre-pass ────────────────────────────────────────────────────────────
fn register_struct_node(int64 node) -> int64 {
    let name        = nd_sv[node];
    let fields_list = nd_i2[node];
    st_count = st_count + 1;
    if (st_count < len(st_names)) { st_names[st_count] = name; }
    else { push(st_names, name); }
    let start = stf_count + 1;
    if (st_count < len(st_starts)) { st_starts[st_count] = start; }
    else { push(st_starts, start); }
    mut size = 0;
    mut fnode = fields_list;
    while (fnode != 0) {
        let fld   = nd_i2[fnode];
        let fname = nd_sv[fld];
        let fty_n = nd_i2[fld];
        let fty   = node_ty_to_int(fty_n);
        let ftsv  = node_ty_sv(fty_n);
        stf_count = stf_count + 1;
        if (stf_count < len(stf_names)) {
            stf_names[stf_count] = fname;
            stf_tys[stf_count]   = fty;
            stf_svs[stf_count]   = ftsv;
        } else {
            push(stf_names, fname);
            push(stf_tys,   fty);
            push(stf_svs,   ftsv);
        }
        size  = size + 1;
        fnode = nd_i3[fnode];
    }
    if (st_count < len(st_sizes)) { st_sizes[st_count] = size; }
    else { push(st_sizes, size); }
    return 0;
}

fn pre_pass_structs(int64 structs_list) -> int64 {
    mut snode = structs_list;
    while (snode != 0) { register_struct_node(nd_i2[snode]); snode = nd_i3[snode]; }
    return 0;
}

// ── Function signature pre-pass ───────────────────────────────────────────────
fn register_fn_node(int64 node) -> int64 {
    let name        = nd_sv[node];
    let params_list = nd_i2[node];
    let ret_ty_nd   = nd_i3[node];
    mut ret_ty = TY_VOID;
    mut ret_sv = "";
    if (ret_ty_nd != 0) { ret_ty = node_ty_to_int(ret_ty_nd); ret_sv = node_ty_sv(ret_ty_nd); }
    let hw_node = nd_i5[node];
    fn_count = fn_count + 1;
    if (fn_count < len(fn_names)) {
        fn_names[fn_count]   = name;
        fn_ret_tys[fn_count] = ret_ty;
        fn_ret_svs[fn_count] = ret_sv;
        fn_hws[fn_count]     = hw_node;
        fn_is_builtin[fn_count] = 0;
        fn_pool_poly[fn_count]  = 0;
    } else {
        push(fn_names,   name);
        push(fn_ret_tys, ret_ty);
        push(fn_ret_svs, ret_sv);
        push(fn_hws,     hw_node);
        push(fn_is_builtin, 0);
        push(fn_pool_poly,  0);
    }
    let pstart = fp_count + 1;
    if (fn_count < len(fn_pstarts)) { fn_pstarts[fn_count] = pstart; }
    else { push(fn_pstarts, pstart); }
    mut pcount = 0;
    mut pnode = params_list;
    while (pnode != 0) {
        let param = nd_i2[pnode];
        let pty   = node_ty_to_int(nd_i2[param]);
        let ptsv  = node_ty_val_sv(nd_i2[param]);
        fp_count = fp_count + 1;
        if (fp_count < len(fp_tys)) {
            fp_tys[fp_count] = pty; fp_svs[fp_count] = ptsv;
            fp_anyplace[fp_count] = 0;
        } else {
            push(fp_tys, pty); push(fp_svs, ptsv);
            push(fp_anyplace, 0);
        }
        pcount = pcount + 1;
        pnode  = nd_i3[pnode];
    }
    if (fn_count < len(fn_pcounts)) { fn_pcounts[fn_count] = pcount; }
    else { push(fn_pcounts, pcount); }
    return 0;
}

fn pre_pass_fns(int64 fns_list) -> int64 {
    mut fnode = fns_list;
    while (fnode != 0) { register_fn_node(nd_i2[fnode]); fnode = nd_i3[fnode]; }
    return 0;
}

// ── Built-in function registration ────────────────────────────────────────────

// Declare the type of one parameter of the built-in registered most recently.
// Call it immediately after register_builtin:
//
//     register_builtin("mlx_zeros", 2, TY_TENSOR_CPU, "");
//     bparam(1, TY_ARRAY);      // shape
//     bparam(2, TY_INT64);      // dtype
//
// Until this existed every builtin parameter was TY_UNKNOWN, which means the
// checker accepted literally any argument: `mlx_zeros(2, 2)` and
// `str_len(42)` both typechecked and then segfaulted in the runtime. A type
// checker that cannot reject a wrong-typed call into its own standard library
// is not enforcing anything, and it makes any *placement* rule built on top of
// it unsound — you cannot enforce where a value lives if you never established
// what the value is.
//
// Parameters left unspecified stay TY_UNKNOWN, which ty_compat treats as
// "matches anything". That is the right default for genuinely polymorphic
// builtins (`format` takes a variable number of strings; `len`/`push` work on
// every array element type), and a deliberate escape hatch everywhere else.
fn bparam(int64 idx, int64 ty) -> int64 {
    let base = fn_pstarts[fn_count];
    fp_tys[base + idx - 1] = ty;
    // A tensor parameter of a *builtin* accepts either pool. Builtins are the
    // operations of the pool model, so they must work on whichever pool their
    // operands live in — `mlx_add(gpu_a, gpu_b)` is the entire reason
    // `tensor@gpu` exists. User functions are different: a
    // `@cpu fn(tensor@cpu x)` is a promise about where the work happens, and
    // violating it is the error placement types exist to catch.
    //
    // Marking it here rather than at each call site means the whole
    // registration table is covered by one rule, and a builtin cannot be
    // forgotten. `bparams_tensor` funnels through here too.
    if (ty == TY_TENSOR_CPU || ty == TY_TENSOR_GPU) {
        fp_anyplace[base + idx - 1] = 1;
    }
    return 0;
}

// Convenience: declare the first `n` parameters as tensor handles of either
// pool. MLX's entry points are overwhelmingly of the form (tensor, tensor, ...)
// so this keeps the registration table readable.
fn bparams_tensor(int64 n) -> int64 {
    mut i = 1;
    while (i <= n) { bparam(i, TY_TENSOR_CPU); i = i + 1; }
    return 0;
}

fn register_builtin(string name, int64 pcount, int64 ret_ty, string ret_sv) -> int64 {
    fn_count = fn_count + 1;
    if (fn_count < len(fn_names)) {
        fn_names[fn_count]   = name;
        fn_ret_tys[fn_count] = ret_ty;
        fn_ret_svs[fn_count] = ret_sv;
        fn_pcounts[fn_count] = pcount;
        fn_hws[fn_count]     = 0;
        fn_is_builtin[fn_count] = 1;
        fn_pool_poly[fn_count]  = 0;
    } else {
        push(fn_names,   name);
        push(fn_ret_tys, ret_ty);
        push(fn_ret_svs, ret_sv);
        push(fn_pcounts, pcount);
        push(fn_hws,     0);
        push(fn_is_builtin, 1);
        push(fn_pool_poly,  0);
    }
    let pstart = fp_count + 1;
    if (fn_count < len(fn_pstarts)) { fn_pstarts[fn_count] = pstart; }
    else { push(fn_pstarts, pstart); }
    // Push TY_UNKNOWN for each param so any arg type is accepted
    mut pi = 0;
    while (pi < pcount) {
        fp_count = fp_count + 1;
        if (fp_count < len(fp_tys)) {
            fp_tys[fp_count] = TY_UNKNOWN; fp_svs[fp_count] = "";
            fp_anyplace[fp_count] = 0;
        } else {
            push(fp_tys, TY_UNKNOWN); push(fp_svs, "");
            push(fp_anyplace, 0);
        }
        pi = pi + 1;
    }
    return 0;
}

fn register_builtins() -> int64 {
    // print/println/format stay polymorphic: they accept int64, float64,
    // string, and arrays, and the codegen picks the variant from the argument
    // type. Leaving their parameter TY_UNKNOWN is what lets that dispatch work.
    register_builtin("print",             1, TY_VOID,    "");
    register_builtin("println",           1, TY_VOID,    "");
    register_builtin("format",           -1, TY_STR,     "");
    // len/push/arr_reset are polymorphic over the element type ([int64],
    // [string], [float64] are all distinct runtime-visible types).
    register_builtin("len",               1, TY_INT64,   "");
    register_builtin("push",              2, TY_VOID,    "");
    register_builtin("arr_reset",         1, TY_VOID,    "");
    register_builtin("arr_push_i64",      2, TY_INT64,   "");
    bparam(2, TY_INT64);
    // Conversion and strings — every parameter here has exactly one type.
    register_builtin("int64_to_str",      1, TY_STR,     ""); bparam(1, TY_INT64);
    register_builtin("float64_to_str",    1, TY_STR,     ""); bparam(1, TY_FLOAT64);
    register_builtin("char_to_str",       1, TY_STR,     ""); bparam(1, TY_INT64);
    register_builtin("str_concat",        2, TY_STR,     "");
    bparam(1, TY_STR); bparam(2, TY_STR);
    register_builtin("str_len",           1, TY_INT64,   ""); bparam(1, TY_STR);
    register_builtin("str_eq",            2, TY_INT64,   "");
    bparam(1, TY_STR); bparam(2, TY_STR);
    register_builtin("str_index",         2, TY_INT64,   "");
    bparam(1, TY_STR); bparam(2, TY_INT64);
    register_builtin("str_slice",         3, TY_STR,     "");
    bparam(1, TY_STR); bparam(2, TY_INT64); bparam(3, TY_INT64);
    register_builtin("str_contains",      2, TY_INT64,   "");
    bparam(1, TY_STR); bparam(2, TY_STR);
    register_builtin("str_starts_with",   2, TY_INT64,   "");
    bparam(1, TY_STR); bparam(2, TY_STR);
    register_builtin("str_ends_with",     2, TY_INT64,   "");
    bparam(1, TY_STR); bparam(2, TY_STR);
    register_builtin("str_replace",       3, TY_STR,     "");
    bparam(1, TY_STR); bparam(2, TY_STR); bparam(3, TY_STR);
    register_builtin("str_to_int64",      1, TY_INT64,   ""); bparam(1, TY_STR);
    register_builtin("get_arg",           1, TY_STR,     ""); bparam(1, TY_INT64);
    register_builtin("exit",              1, TY_VOID,    ""); bparam(1, TY_INT64);
    register_builtin("getenv",            1, TY_STR,     ""); bparam(1, TY_STR);
    // Math. abs() is int64 (see the runtime: ionic_abs takes int64_t); fabs()
    // is the float one. docs/language.md used to document abs as float64,
    // which was wrong.
    register_builtin("sqrt",              1, TY_FLOAT64, ""); bparam(1, TY_FLOAT64);
    register_builtin("fabs",              1, TY_FLOAT64, ""); bparam(1, TY_FLOAT64);
    register_builtin("pow",               2, TY_FLOAT64, "");
    bparam(1, TY_FLOAT64); bparam(2, TY_FLOAT64);
    register_builtin("floor",             1, TY_FLOAT64, ""); bparam(1, TY_FLOAT64);
    register_builtin("ceil",              1, TY_FLOAT64, ""); bparam(1, TY_FLOAT64);
    register_builtin("abs",               1, TY_INT64,   ""); bparam(1, TY_INT64);
    register_builtin("int64_to_float64",  1, TY_FLOAT64, ""); bparam(1, TY_INT64);
    register_builtin("float64_to_int64",  1, TY_INT64,   ""); bparam(1, TY_FLOAT64);
    register_builtin("min",               2, TY_INT64,   "");
    bparam(1, TY_INT64); bparam(2, TY_INT64);
    register_builtin("max",               2, TY_INT64,   "");
    bparam(1, TY_INT64); bparam(2, TY_INT64);
    register_builtin("str_hash",          1, TY_INT64,   ""); bparam(1, TY_STR);
    register_builtin("cpu_core_count",    0, TY_INT64,   "");
    register_builtin("target_is_linux",   0, TY_INT64,   "");
    register_builtin("read_line",         0, TY_STR,     "");
    // File I/O — paths and contents are strings.
    register_builtin("file_read",         1, TY_STR,     ""); bparam(1, TY_STR);
    register_builtin("file_write",        2, TY_VOID,    "");
    bparam(1, TY_STR); bparam(2, TY_STR);
    register_builtin("file_write_binary", 2, TY_VOID,    ""); bparam(2, TY_STR);
    register_builtin("file_size",         1, TY_INT64,   ""); bparam(1, TY_STR);
    register_builtin("system",            1, TY_INT64,   ""); bparam(1, TY_STR);
    // The *_bits helpers are the compile-time float path: they take and return
    // raw IEEE-754 bit patterns in int64 slots.
    register_builtin("str_to_float64_bits", 1, TY_INT64, ""); bparam(1, TY_STR);
    register_builtin("fadd_bits",         2, TY_INT64,   ""); bparams_tensor(0);
    register_builtin("fsub_bits",         2, TY_INT64,   "");
    register_builtin("fmul_bits",         2, TY_INT64,   "");
    register_builtin("fdiv_bits",         2, TY_INT64,   "");
    register_builtin("sqrt_bits",         1, TY_INT64,   "");
    register_builtin("fabs_bits",         1, TY_INT64,   "");
    register_builtin("floor_bits",        1, TY_INT64,   "");
    register_builtin("ceil_bits",         1, TY_INT64,   "");
    register_builtin("int_to_fbits",      1, TY_INT64,   "");
    // Web request primitives
    register_builtin("http_get",         1, TY_STR,     ""); bparam(1, TY_STR);
    register_builtin("http_post",        2, TY_STR,     "");
    bparam(1, TY_STR); bparam(2, TY_STR);
    register_builtin("http_status",      1, TY_INT64,   ""); bparam(1, TY_STR);
    register_builtin("http_body",        1, TY_STR,     ""); bparam(1, TY_STR);
    register_builtin("http_urlencode",   1, TY_STR,     ""); bparam(1, TY_STR);
    // HTTP server + BPE tokenizer (see the "Local inference server" section of
    // docs/guide.md). The server is single-request-at-a-time by design; the
    // tokenizer is what turns token ids into text and back.
    register_builtin("bpe_load",         1, TY_INT64,   ""); bparam(1, TY_STR);
    register_builtin("bpe_encode",       3, TY_INT64,   "");
    bparam(1, TY_STR); bparam(3, TY_INT64);
    register_builtin("bpe_decode",       1, TY_STR,     "");
    register_builtin("bpe_bos",          0, TY_INT64,   "");
    register_builtin("bpe_eos",          0, TY_INT64,   "");
    register_builtin("http_serve",       1, TY_INT64,   ""); bparam(1, TY_INT64);
    register_builtin("http_accept",      1, TY_INT64,   ""); bparam(1, TY_INT64);
    register_builtin("http_method",      1, TY_STR,     ""); bparam(1, TY_INT64);
    register_builtin("http_path",        1, TY_STR,     ""); bparam(1, TY_INT64);
    register_builtin("http_req_body",    1, TY_STR,     ""); bparam(1, TY_INT64);
    register_builtin("http_req_done",    1, TY_INT64,   ""); bparam(1, TY_INT64);
    register_builtin("http_respond",     4, TY_INT64,   "");
    bparam(1, TY_INT64); bparam(2, TY_INT64); bparam(3, TY_STR); bparam(4, TY_STR);
    register_builtin("http_close",       1, TY_INT64,   ""); bparam(1, TY_INT64);
    // Terminal / alternate-screen TUI primitives
    register_builtin("term_enter",        0, TY_INT64,   "");
    register_builtin("term_exit",         0, TY_INT64,   "");
    register_builtin("term_write",        1, TY_INT64,   ""); bparam(1, TY_STR);
    register_builtin("term_flush",        0, TY_INT64,   "");
    register_builtin("term_size",         0, TY_INT64,   "");
    register_builtin("term_poll",         1, TY_INT64,   ""); bparam(1, TY_INT64);
    register_builtin("term_key",          0, TY_INT64,   "");
    // ML / model inference
    register_builtin("load_model",        1, TY_MODEL_CPU,""); bparam(1, TY_STR);
    register_builtin("model_free",        1, TY_VOID,    ""); bparam(1, TY_MODEL_CPU);
    register_builtin("model_forward",     2, TY_TENSOR_CPU,""); bparam(1, TY_MODEL_CPU);
    register_builtin("piper_forward",     5, TY_ARRAY,   "");
    bparam(1, TY_MODEL_CPU);
    register_builtin("write_wav",         4, TY_VOID,    "");
    bparam(1, TY_STR); bparam(3, TY_INT64); bparam(4, TY_INT64);

    // ── MLX tensor backend ──────────────────────────────────────────────────
    // Handles are typed `tensor@cpu` deliberately: they are host-side handles
    // to a lazily-built device graph, and `tensor@gpu` would make them
    // unusable outside a `gpu { }` block (the checker forbids that). Use
    // `.toGpu()` when you want to enter a GPU context; it is a no-op transfer.
    //
    // Note: no RAII here. Unlike `load_model`, an mlx handle is not
    // auto-freed at scope exit — call mlx_free() explicitly.
    //
    // Parameter types are declared, not left TY_UNKNOWN. That is what makes
    // the placement rules meaningful: `mlx_matmul(42, x)` is now rejected at
    // compile time instead of reaching the runtime and dereferencing an
    // integer. Integer parameters (dtype, axis, keepdims, index) are typed
    // too, so `mlx_dim(a, "0")` is an error rather than a call that silently
    // reads a string pointer as an index.
    // Construction
    register_builtin("mlx_zeros",         2, TY_TENSOR_CPU, "");
    bparam(1, TY_ARRAY); bparam(2, TY_INT64);
    register_builtin("mlx_ones",          2, TY_TENSOR_CPU, "");
    bparam(1, TY_ARRAY); bparam(2, TY_INT64);
    register_builtin("mlx_full",          3, TY_TENSOR_CPU, "");
    bparam(1, TY_ARRAY); bparam(2, TY_FLOAT64); bparam(3, TY_INT64);
    register_builtin("mlx_arange",        4, TY_TENSOR_CPU, "");
    bparam(1, TY_FLOAT64); bparam(2, TY_FLOAT64); bparam(3, TY_FLOAT64); bparam(4, TY_INT64);
    register_builtin("mlx_eye",           3, TY_TENSOR_CPU, "");
    bparam(1, TY_INT64); bparam(2, TY_INT64); bparam(3, TY_INT64);
    register_builtin("mlx_random_normal", 4, TY_TENSOR_CPU, "");
    bparam(1, TY_ARRAY); bparam(2, TY_FLOAT64); bparam(3, TY_FLOAT64); bparam(4, TY_INT64);
    register_builtin("mlx_random_uniform",4, TY_TENSOR_CPU, "");
    bparam(1, TY_ARRAY); bparam(2, TY_FLOAT64); bparam(3, TY_FLOAT64); bparam(4, TY_INT64);
    register_builtin("mlx_from_array",    3, TY_TENSOR_CPU, "");
    bparam(1, TY_ARRAY); bparam(2, TY_ARRAY); bparam(3, TY_INT64);
    // Lifetime / materialisation
    register_builtin("mlx_free",          1, TY_VOID,    "");
    bparam(1, TY_TENSOR_CPU);
    register_builtin("mlx_eval",          1, TY_INT64,   "");
    bparam(1, TY_TENSOR_CPU);
    register_builtin("mlx_to_array",      1, TY_ARRAY,   "");
    bparam(1, TY_TENSOR_CPU);
    register_builtin("mlx_item",          1, TY_FLOAT64, "");
    bparam(1, TY_TENSOR_CPU);
    // Inspection
    register_builtin("mlx_ndim",          1, TY_INT64,   "");
    bparam(1, TY_TENSOR_CPU);
    register_builtin("mlx_size",          1, TY_INT64,   "");
    bparam(1, TY_TENSOR_CPU);
    register_builtin("mlx_dim",           2, TY_INT64,   "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    register_builtin("mlx_shape",         1, TY_ARRAY,   "");
    bparam(1, TY_TENSOR_CPU);
    register_builtin("mlx_dtype",         1, TY_INT64,   "");
    bparam(1, TY_TENSOR_CPU);
    // Pool introspection (Stage C). `mlx_pool` takes a tensor and reports which
    // pool its bytes are charged to (0 = SRAM, 1 = VRAM), so a test can assert
    // that a transfer moved the value rather than only retyping it.
    // `mlx_pool_bytes` reports a pool's current occupancy, which is what a
    // capacity budget bounds.
    register_builtin("mlx_pool",          1, TY_INT64,   "");
    bparam(1, TY_TENSOR_CPU);
    register_builtin("mlx_pool_bytes",    1, TY_INT64,   "");
    bparam(1, TY_INT64);
    // The declared size of a pool (0 = unbounded), so a program can compare what
    // it declared against what the device actually has. The runtime enforces it
    // either way; this only makes the number readable.
    register_builtin("mlx_pool_capacity", 1, TY_INT64,   "");
    bparam(1, TY_INT64);
    register_builtin("mlx_pool_count",    0, TY_INT64,   "");
    register_builtin("mlx_pools_unified", 0, TY_INT64,   "");
    // Elementwise binary
    register_builtin("mlx_add",           2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    register_builtin("mlx_subtract",      2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    register_builtin("mlx_multiply",      2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    register_builtin("mlx_divide",        2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    register_builtin("mlx_power",         2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    register_builtin("mlx_maximum",       2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    register_builtin("mlx_minimum",       2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    register_builtin("mlx_matmul",        2, TY_TENSOR_CPU, ""); bparams_tensor(2);
    // Elementwise unary
    register_builtin("mlx_negative",      1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_square",        1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_sqrt",          1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_exp",           1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_log",           1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_abs",           1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_tanh",          1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_erf",           1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    register_builtin("mlx_contiguous",    1, TY_TENSOR_CPU, ""); bparams_tensor(1);
    // Reductions
    register_builtin("mlx_sum",           2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    register_builtin("mlx_mean",          2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    register_builtin("mlx_max",           2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    register_builtin("mlx_min",           2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    register_builtin("mlx_sum_axis",      3, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64); bparam(3, TY_INT64);
    register_builtin("mlx_mean_axis",     3, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64); bparam(3, TY_INT64);
    register_builtin("mlx_argmax",        3, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64); bparam(3, TY_INT64);
    register_builtin("mlx_softmax",       2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    register_builtin("mlx_log_softmax",   2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    // Shape
    register_builtin("mlx_reshape",       2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_ARRAY);
    register_builtin("mlx_transpose",     2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_ARRAY);
    register_builtin("mlx_astype",        2, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64);
    register_builtin("mlx_slice",         4, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64); bparam(3, TY_INT64); bparam(4, TY_INT64);
    register_builtin("mlx_take",          3, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_ARRAY); bparam(3, TY_INT64);
    register_builtin("mlx_concatenate",   3, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_TENSOR_CPU); bparam(3, TY_INT64);
    // NN primitives
    register_builtin("mlx_sdpa",          5, TY_TENSOR_CPU, "");
    bparams_tensor(3); bparam(4, TY_FLOAT64); bparam(5, TY_INT64);
    register_builtin("mlx_rms_norm",      3, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_TENSOR_CPU); bparam(3, TY_FLOAT64);
    register_builtin("mlx_layer_norm",    4, TY_TENSOR_CPU, "");
    bparams_tensor(3); bparam(4, TY_FLOAT64);
    register_builtin("mlx_rope",          5, TY_TENSOR_CPU, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_INT64); bparam(3, TY_FLOAT64);
    bparam(4, TY_INT64); bparam(5, TY_INT64);
    // Diagnostics / memory
    register_builtin("mlx_available",       0, TY_INT64, "");
    register_builtin("mlx_metal_available", 0, TY_INT64, "");
    register_builtin("mlx_last_error",      0, TY_STR,   "");
    register_builtin("mlx_clear_error",     0, TY_INT64, "");
    register_builtin("mlx_active_memory",   0, TY_INT64, "");
    register_builtin("mlx_peak_memory",     0, TY_INT64, "");
    register_builtin("mlx_reset_peak_memory",0, TY_INT64,"");
    register_builtin("mlx_clear_cache",     0, TY_INT64, "");
    register_builtin("mlx_set_memory_limit",1, TY_INT64, "");
    bparam(1, TY_INT64);
    // Safetensors
    register_builtin("mlx_load_safetensors", 1, TY_INT64, "");
    register_builtin("mlx_weights_free",     1, TY_VOID,  "");
    register_builtin("mlx_weights_count",    1, TY_INT64, "");
    register_builtin("mlx_weights_at",       2, TY_TENSOR_CPU, "");
    bparam(2, TY_INT64);
    register_builtin("mlx_weights_key_at",   2, TY_STR,   "");
    bparam(2, TY_INT64);
    register_builtin("mlx_weights_get",      2, TY_TENSOR_CPU, "");
    bparam(2, TY_STR);
    register_builtin("mlx_save_safetensors", 3, TY_INT64, "");
    bparam(1, TY_TENSOR_CPU); bparam(2, TY_STR); bparam(3, TY_STR);
    finalize_pool_poly();
    return 0;
}

// Mark the builtins whose *result* pool is inferred from their operands.
//
// A builtin that takes a tensor and returns a tensor computes in whichever
// pool its operands live in: `mlx_add(gpu_a, gpu_b)` produces a GPU-resident
// result, and `mlx_add(cpu_a, cpu_b)` an SRAM-resident one. The builtin is
// the operation of the pool model, not a promise about one particular pool.
//
// The rule is derived from the registration table rather than restated per
// builtin, so it cannot drift:
//
//   pool-polymorphic  ⇔  builtin ∧ returns a tensor ∧ takes a tensor operand
//
// Builtins that *construct* a tensor (mlx_zeros, mlx_ones, mlx_from_array,
// …) take no tensor operand, so there is nothing to infer from and they
// allocate in SRAM. Transferring into the accelerator pool is an explicit
// `.toGpu()`, which is the operation the pool budget is charged for.
//
// Builtins that take a model (model_forward) keep their declared result pool:
// the model is SRAM-resident, so the result is SRAM-resident.
fn finalize_pool_poly() -> int64 {
    mut i = 1;
    while (i <= fn_count) {
        if (fn_is_builtin[i] == 1) {
            let ret = fn_ret_tys[i];
            if (ret == TY_TENSOR_CPU || ret == TY_TENSOR_GPU) {
                let base = fn_pstarts[i];
                let np   = fn_pcounts[i];
                mut j = 1;
                while (j <= np && fn_pool_poly[i] == 0) {
                    if (fp_anyplace[base + j - 1] == 1) { fn_pool_poly[i] = 1; }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

// ── Count a CONS list ─────────────────────────────────────────────────────────
fn cons_len(int64 list) -> int64 {
    mut n = 0;
    mut cur = list;
    while (cur != 0) { n = n + 1; cur = nd_i3[cur]; }
    return n;
}

// ── sc_expr: infer type of node, set sc_ty/sc_sv/sc_elem_ty ─────────────────
fn sc_expr(int64 node) -> int64 {
    if (node == 0) { sc_ty = TY_UNKNOWN; sc_sv = ""; return 0; }
    sc_active_node = node;
    let k = nd_kind[node];

    // ── Literals ─────────────────────────────────────────────────────────────
    if (k == ND_INT)   { sc_ty = TY_INT64;   sc_sv = ""; return 0; }
    if (k == ND_FLOAT) { sc_ty = TY_FLOAT64; sc_sv = ""; return 0; }
    if (k == ND_BOOL)  { sc_ty = TY_BOOL;    sc_sv = ""; return 0; }
    if (k == ND_STR)   { sc_ty = TY_STR;     sc_sv = ""; return 0; }

    // ── Variable reference ────────────────────────────────────────────────────
    if (k == ND_IDENT) {
        let name = nd_sv[node];
        if (!sv_is_defined(name)) {
            sc_error_at(str_concat("undefined variable '", str_concat(name, "'")), "not declared in this scope");
            sc_hint_did_you_mean("variable", suggest_var(name));
            sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
        }
        // A value a previous transfer consumed no longer belongs to this name.
        // Report it here rather than at each use site, so every reference — as
        // an argument, an initialiser, a return value — is covered by one rule.
        sc_check_not_moved(name);
        sc_ty = sv_lookup_ty(name);
        sc_sv = sv_lookup_sv_val(name);
        // tensor@cpu cannot be used directly inside a gpu block
        if (sc_in_gpu_block == 1 && sc_ty == TY_TENSOR_CPU && sc_in_conversion == 0) {
            sc_error_at(str_concat("tensor@cpu '", str_concat(name, "' used inside gpu block")),
                "call .toGpu() to move it to the GPU first");
        }
        // tensor@gpu cannot be used directly outside a gpu block
        if (sc_in_gpu_block == 0 && sc_ty == TY_TENSOR_GPU && sc_in_conversion == 0) {
            sc_error_at(str_concat("tensor@gpu '", str_concat(name, "' used outside gpu block")),
                "call .toCpu() to bring it back to the CPU first");
        }
        return 0;
    }

    // ── Binary operators ──────────────────────────────────────────────────────
    if (k == ND_BINOP) {
        let op = nd_iv[node];
        sc_expr(nd_i2[node]); let lty = sc_ty; let lsv = sc_sv;
        sc_expr(nd_i3[node]); let rty = sc_ty;

        // Arithmetic: +, -, *, /, %
        if (op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_MOD) {
            if (lty == TY_STR && op == OP_ADD) {
                if (rty != TY_STR && rty != TY_UNKNOWN) {
                    sc_error_at("type error in +", str_concat("right side must be string, got ", ty_name(rty, "")));
                }
                sc_ty = TY_STR; sc_sv = ""; return 0;
            }
            if (lty != TY_UNKNOWN && rty != TY_UNKNOWN) {
                if (lty != TY_INT64 && lty != TY_FLOAT64) {
                    sc_error_at("type error in arithmetic", str_concat("expected numeric type, got ", ty_name(lty, lsv)));
                }
                if (lty == TY_FLOAT64 || rty == TY_FLOAT64) {
                    sc_ty = TY_FLOAT64; sc_sv = "";
                    // Promote integer op to float op in the AST node
                    if (op == OP_ADD) { nd_iv[node] = OP_FADD; }
                    if (op == OP_SUB) { nd_iv[node] = OP_FSUB; }
                    if (op == OP_MUL) { nd_iv[node] = OP_FMUL; }
                    if (op == OP_DIV) { nd_iv[node] = OP_FDIV; }
                    return 0;
                }
            }
            sc_ty = TY_INT64; sc_sv = ""; return 0;
        }

        // Comparisons: ==, !=, <, >, <=, >=
        if (op == OP_EQEQ || op == OP_NEQ) {
            if (lty != TY_UNKNOWN && rty != TY_UNKNOWN && !ty_compat(lty, rty)) {
                sc_error_at("type error in ==", str_concat(str_concat("cannot compare ", ty_name(lty, lsv)), str_concat(" with ", ty_name(rty, ""))));
            }
            sc_ty = TY_BOOL; sc_sv = ""; return 0;
        }
        if (op == OP_LT || op == OP_GT || op == OP_LTEQ || op == OP_GTEQ) {
            if (lty != TY_UNKNOWN && lty != TY_INT64 && lty != TY_FLOAT64) {
                sc_error_at("type error in comparison", str_concat("expected numeric type, got ", ty_name(lty, lsv)));
            }
            sc_ty = TY_BOOL; sc_sv = ""; return 0;
        }

        // Logical: &&, ||
        if (op == OP_AND || op == OP_OR) {
            sc_ty = TY_BOOL; sc_sv = ""; return 0;
        }

        sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
    }

    // ── Unary operators ───────────────────────────────────────────────────────
    if (k == ND_UNOP) {
        let op = nd_iv[node];
        sc_expr(nd_i2[node]); let uty = sc_ty;
        if (op == OP_NEG) {
            if (uty != TY_INT64 && uty != TY_FLOAT64 && uty != TY_UNKNOWN) {
                sc_error_at("type error in unary -", str_concat("expected numeric, got ", ty_name(uty, "")));
            }
            sc_ty = uty; sc_sv = ""; return 0;
        }
        if (op == OP_NOT) {
            sc_ty = TY_BOOL; sc_sv = ""; return 0;
        }
        sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
    }

    // ── Function call ─────────────────────────────────────────────────────────
    if (k == ND_CALL) {
        let callee = nd_sv[node];
        let args_list = nd_i2[node];
        let got_argc = cons_len(args_list);

        if (sc_in_gpu_block == 1 && is_cpu_only_fn(callee)) {
            sc_error_at(str_concat("'", str_concat(callee, "' is CPU-only I/O, not allowed inside gpu block")),
                "gpu blocks may only perform tensor compute");
        }

        let fi = fn_find(callee);
        if (fi == 0) {
            sc_error_at(str_concat("unknown function '", str_concat(callee, "'")), "not declared");
            sc_hint_did_you_mean("function", suggest_fn(callee));
            sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
        }

        // A @cpu-annotated function cannot run inside a GPU context.
        if (sc_in_gpu_block == 1 && hw_ann_is_cpu(fn_hws[fi])) {
            sc_error_at(str_concat("@cpu function '", str_concat(callee, "'")),
                "cannot be called from a GPU context (gpu block or @gpu fn)");
        }

        let want_argc = fn_pcounts[fi];
        if (want_argc >= 0 && got_argc != want_argc) {
            sc_error_at(str_concat("wrong arg count calling '", str_concat(callee, "'")),
                str_concat(str_concat("expected ", int64_to_str(want_argc)),
                           str_concat(", got ", int64_to_str(got_argc))));
        }

        // Track the pools of the tensor operands. `first_pool` is the pool of
        // the first tensor operand — the one a pool-polymorphic builtin's
        // result lives in. `other_pool` / `other_idx` record a disagreeing
        // operand so the diagnostic can name both sides.
        mut first_pool  = 0;
        mut first_idx   = 0;
        mut other_pool  = 0;
        mut other_idx   = 0;
        mut anode = args_list;
        mut pidx  = 1;
        while (anode != 0) {
            sc_expr(nd_i2[anode]);
            let arg_ty = sc_ty;
            if (pidx <= want_argc) {
                let base = fn_pstarts[fi];
                let paty = fp_tys[base + pidx - 1];
                let pasv = fp_svs[base + pidx - 1];
                if (fp_anyplace[base + pidx - 1] == 1) {
                    // A builtin tensor operand. It may live in either pool —
                    // that is the whole point of pool polymorphism — but every
                    // operand of one call must agree, because the operation
                    // runs in a single pool.
                    if (arg_ty == TY_TENSOR_CPU || arg_ty == TY_TENSOR_GPU) {
                        if (first_pool == 0) {
                            first_pool = arg_ty;
                            first_idx  = pidx;
                        } else if (arg_ty != first_pool && other_pool == 0) {
                            other_pool = arg_ty;
                            other_idx  = pidx;
                        }
                    } else if (arg_ty != TY_UNKNOWN) {
                        sc_error_at(str_concat("type error in arg ", str_concat(int64_to_str(pidx), str_concat(" of '", str_concat(callee, "'")))),
                            str_concat(str_concat(str_concat("expected ", ty_name(paty, pasv)),
                                                  str_concat(", got ", ty_name(arg_ty, ""))),
                                       tensor_convert_hint(arg_ty, paty)));
                    }
                } else if (!ty_compat(arg_ty, paty)) {
                    sc_error_at(str_concat("type error in arg ", str_concat(int64_to_str(pidx), str_concat(" of '", str_concat(callee, "'")))),
                        str_concat(str_concat(str_concat("expected ", ty_name(paty, pasv)),
                                              str_concat(", got ", ty_name(arg_ty, ""))),
                                   tensor_convert_hint(arg_ty, paty)));
                }
            }
            anode = nd_i3[anode];
            pidx  = pidx + 1;
        }

        // Mixed-pool operands. This is not an extra restriction invented on
        // top of pool polymorphism — it is what makes the result-pool
        // inference below well defined. `mlx_add(cpu_a, gpu_b)` has no
        // single pool to compute in, and the backend would not check: the
        // MLX probes showed that a mixed-device addition returns silently
        // wrong data rather than failing. The compiler has to catch it.
        if (other_pool != 0) {
            // Point at the call, not at whichever operand happened to be
            // visited last.
            sc_active_node = node;
            sc_error_at(str_concat("mixed memory pools in call to '", str_concat(callee, "'")),
                str_concat(str_concat(str_concat("operand ", str_concat(int64_to_str(first_idx), " is ")),
                                      ty_name(first_pool, "")),
                           str_concat(str_concat(", but operand ", str_concat(int64_to_str(other_idx), " is ")),
                                      str_concat(ty_name(other_pool, ""), " (move both operands to the same pool first)"))));
        }

        sc_ty  = fn_ret_tys[fi];
        sc_sv  = fn_ret_svs[fi];
        // A pool-polymorphic builtin produces its result in the pool its
        // operands live in: `mlx_add(gpu_a, gpu_b)` is GPU-resident,
        // `mlx_add(cpu_a, cpu_b)` is SRAM-resident. The builtin is the
        // operation of the pool model, not a promise about one pool.
        if (fn_pool_poly[fi] == 1 && first_pool != 0) {
            sc_ty = first_pool;
        }
        return 0;
    }

    // ── Method call: obj.method(args) ─────────────────────────────────────────
    if (k == ND_METHOD_CALL) {
        let method = nd_sv[node];
        sc_expr(nd_i2[node]); let obj_ty = sc_ty; let obj_sv = sc_sv;

        if (str_eq(method, "push")) {
            sc_ty = TY_VOID; sc_sv = ""; return 0;
        }
        if (str_eq(method, "toGpu")) {
            if (obj_ty != TY_TENSOR_CPU && obj_ty != TY_UNKNOWN) {
                sc_error_at("toGpu", "can only call toGpu() on tensor@cpu");
            }
            sc_consume_operand(nd_i2[node], nd_line[node], ".toGpu()");
            sc_ty = TY_TENSOR_GPU; sc_sv = ""; return 0;
        }
        if (str_eq(method, "toCpu")) {
            if (obj_ty != TY_TENSOR_GPU && obj_ty != TY_UNKNOWN) {
                sc_error_at("toCpu", "can only call toCpu() on tensor@gpu");
            }
            sc_consume_operand(nd_i2[node], nd_line[node], ".toCpu()");
            sc_ty = TY_TENSOR_CPU; sc_sv = ""; return 0;
        }
        if (str_eq(method, "forward")) {
            sc_ty = TY_TENSOR_CPU; sc_sv = ""; return 0;
        }
        sc_error_at(str_concat("unknown method '", str_concat(method, "'")), "no such method");
        sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
    }

    // ── Field access: obj.field ───────────────────────────────────────────────
    if (k == ND_FIELD_ACCESS) {
        let field = nd_sv[node];
        sc_expr(nd_i2[node]); let obj_ty = sc_ty; let obj_sv = sc_sv;
        if (obj_ty == TY_UNKNOWN) { sc_ty = TY_UNKNOWN; sc_sv = ""; return 0; }
        if (obj_ty == TY_ARRAY && str_eq(field, "len")) {
            sc_ty = TY_INT64; sc_sv = ""; return 0;
        }
        if (obj_ty != TY_STRUCT) {
            sc_error_at(str_concat("field access on non-struct '", str_concat(field, "'")), ty_name(obj_ty, obj_sv));
            sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
        }
        let st_idx = st_find(obj_sv);
        if (st_idx == 0) {
            sc_error_at(str_concat("unknown struct '", str_concat(obj_sv, "'")), "not declared");
            sc_hint_did_you_mean("struct", suggest_struct(obj_sv));
            sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
        }
        let fty = st_field_ty(st_idx, field);
        if (fty == TY_UNKNOWN) {
            sc_error_at(str_concat("no field '", str_concat(field, str_concat("' on struct '", str_concat(obj_sv, "'")))), "");
        }
        sc_ty = fty; sc_sv = st_field_sv(st_idx, field); return 0;
    }

    // ── Array index: arr[i] ───────────────────────────────────────────────────
    if (k == ND_INDEX) {
        sc_expr(nd_i2[node]); let obj_ty = sc_ty; let obj_sv = sc_sv;
        sc_expr(nd_i3[node]); let idx_ty = sc_ty;
        if (idx_ty != TY_INT64 && idx_ty != TY_UNKNOWN) {
            sc_error_at("array index", str_concat("index must be int64, got ", ty_name(idx_ty, "")));
        }
        if (obj_ty == TY_STR) {
            sc_ty = TY_INT64; sc_sv = ""; return 0;
        }
        if (obj_ty == TY_ARRAY) {
            sc_ty = elem_from_sv(obj_sv); sc_sv = ""; return 0;
        }
        if (obj_ty != TY_UNKNOWN) {
            sc_error_at("index operator", str_concat("cannot index into ", ty_name(obj_ty, obj_sv)));
        }
        sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
    }

    // ── Array literal ─────────────────────────────────────────────────────────
    if (k == ND_ARRAY_LIT) {
        mut elem_ty = TY_UNKNOWN;
        mut enode = nd_i2[node];
        while (enode != 0) {
            sc_expr(nd_i2[enode]);
            if (elem_ty == TY_UNKNOWN && sc_ty != TY_UNKNOWN) { elem_ty = sc_ty; }
            else if (!ty_compat(sc_ty, elem_ty) && sc_ty != TY_UNKNOWN) {
                sc_error_at("array literal", str_concat("mixed element types: ", str_concat(ty_name(elem_ty, ""), str_concat(" and ", ty_name(sc_ty, "")))));
            }
            enode = nd_i3[enode];
        }
        sc_elem_ty = elem_ty;
        sc_ty = TY_ARRAY; sc_sv = elem_sv(elem_ty); return 0;
    }

    // ── Struct literal ────────────────────────────────────────────────────────
    if (k == ND_STRUCT_LIT) {
        let sname = nd_sv[node];
        let st_idx = st_find(sname);
        if (st_idx == 0) {
            sc_error_at(str_concat("unknown struct '", str_concat(sname, "'")), "not declared");
            sc_hint_did_you_mean("struct", suggest_struct(sname));
            sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
        }
        mut finit = nd_i2[node];
        while (finit != 0) {
            let fnode = nd_i2[finit];
            let fname = nd_sv[fnode];
            let fval  = nd_i2[fnode];
            let decl_ty = st_field_ty(st_idx, fname);
            if (decl_ty == TY_UNKNOWN) {
                sc_error_at(str_concat("unknown field '", str_concat(fname, str_concat("' on struct '", str_concat(sname, "'")))), "");
            } else {
                sc_expr(fval);
                if (!ty_compat(sc_ty, decl_ty)) {
                    sc_error_at(str_concat("field '", str_concat(fname, "'")),
                        str_concat(str_concat("expected ", ty_name(decl_ty, st_field_sv(st_idx, fname))),
                                   str_concat(", got ", ty_name(sc_ty, ""))));
                }
            }
            finit = nd_i3[finit];
        }
        sc_ty = TY_STRUCT; sc_sv = sname; return 0;
    }

    // ── .toGpu() / .toCpu() as expression form ────────────────────────────────
    if (k == ND_TO_GPU) {
        sc_in_conversion = 1;
        sc_expr(nd_i2[node]);
        sc_in_conversion = 0;
        if (sc_ty != TY_TENSOR_CPU && sc_ty != TY_UNKNOWN) {
            sc_error_at("toGpu", "operand must be tensor@cpu");
        }
        sc_consume_operand(nd_i2[node], nd_line[node], ".toGpu()");
        sc_ty = TY_TENSOR_GPU; sc_sv = ""; return 0;
    }
    if (k == ND_TO_CPU) {
        sc_in_conversion = 1;
        sc_expr(nd_i2[node]);
        sc_in_conversion = 0;
        if (sc_ty != TY_TENSOR_GPU && sc_ty != TY_UNKNOWN) {
            sc_error_at("toCpu", "operand must be tensor@gpu");
        }
        sc_consume_operand(nd_i2[node], nd_line[node], ".toCpu()");
        sc_ty = TY_TENSOR_CPU; sc_sv = ""; return 0;
    }

    sc_ty = TY_UNKNOWN; sc_sv = ""; return 0;
}

// ── sc_block_stmts: check statements inside a ND_BLOCK node ──────────────────
fn sc_block_stmts(int64 block_node) -> int64 {
    if (block_node == 0) { return 0; }
    mut cur = nd_i2[block_node];
    while (cur != 0) {
        sc_stmt(nd_i2[cur]);
        cur = nd_i3[cur];
    }
    return 0;
}

// ── sc_stmt: check a single statement node ────────────────────────────────────
fn sc_stmt(int64 node) -> int64 {
    if (node == 0) { return 0; }
    sc_active_node = node;
    let k = nd_kind[node];

    if (k == ND_LET) {
        let name    = nd_sv[node];
        let mut_flag = nd_iv[node];
        let ty_ann  = nd_i2[node];
        let init_nd = nd_i3[node];
        sc_expr(init_nd);
        let init_ty = sc_ty;
        let init_sv_val = sc_sv;
        sc_active_node = node;
        mut decl_ty = init_ty;
        mut decl_sv_val = init_sv_val;
        if (ty_ann != 0) {
            let ann_ty = node_ty_to_int(ty_ann);
            let ann_sv_val = node_ty_val_sv(ty_ann);
            if (!ty_compat(init_ty, ann_ty) && init_ty != TY_UNKNOWN) {
                sc_error_at(str_concat("declaration of '", str_concat(name, "'")),
                    str_concat(str_concat("annotation says ", ty_name(ann_ty, ann_sv_val)),
                               str_concat(", init is ", ty_name(init_ty, ""))));
            }
            decl_ty = ann_ty;
            decl_sv_val = ann_sv_val;
        }
        // A re-`let` in the same scope reuses the symbol slot, so the previous
        // binding's charge must be released first — the new declaration resets
        // sv_bytes/sv_charged to -1/0 and would otherwise leave the old bytes
        // counted in a scope that no longer holds them.
        sv_release_charge(name);
        sv_declare(name, decl_ty, decl_sv_val, mut_flag);
        // Stage B3/B4: a GPU-resident binding is charged against the enclosing
        // scope's budget. Sized values are summed; unsized ones are exempt (see
        // the COVERAGE note on budget_charge).
        if (decl_ty == TY_TENSOR_GPU && sc_budget_bytes >= 0) {
            budget_charge(name, init_nd, node);
        } else {
            // Even outside a budgeted GPU scope, track the size so a later
            // `.toGpu()` inside one can be sized without re-deriving it.
            sv_set_bytes(name, expr_bytes(init_nd));
        }
        return 0;
    }

    if (k == ND_ASSIGN) {
        let target = nd_i2[node];
        let val_nd = nd_i3[node];
        sc_expr(val_nd); let val_ty = sc_ty; let val_sv_val = sc_sv;
        sc_active_node = node;

        let tk = nd_kind[target];
        if (tk == ND_IDENT) {
            let tname = nd_sv[target];
            if (!sv_is_defined(tname)) {
                sc_error_at(str_concat("assignment to '", str_concat(tname, "'")), "variable not declared");
            } else {
                if (sv_lookup_mut(tname) == 0) {
                    sc_error_at(str_concat("assignment to immutable '", str_concat(tname, "'")), "declare with mut to allow reassignment");
                }
                let var_ty = sv_lookup_ty(tname);
                if (!ty_compat(val_ty, var_ty) && val_ty != TY_UNKNOWN) {
                    sc_error_at(str_concat("assignment to '", str_concat(tname, "'")),
                        str_concat(str_concat(str_concat("variable is ", ty_name(var_ty, sv_lookup_sv_val(tname))),
                                              str_concat(", value is ", ty_name(val_ty, val_sv_val))),
                                   tensor_convert_hint(val_ty, var_ty)));
                }
                // Reassignment is a second way to create a GPU-resident value, and
                // it was not budget-checked at all: `let` was charged, `x = ...`
                // was not, so
                //
                //     mut slot = mlx_zeros([1024, 1024], 0).toGpu();
                //     slot = mlx_zeros([20000, 20000], 0).toGpu();   // 1.6 GiB
                //
                // compiled against a 1 GiB pool. Replacing the value releases the
                // old one's bytes, so the accounting is: release what the name
                // currently holds, then charge the new value. Charging without the
                // release would count a reused slot once per assignment — and
                // releasing *another scope's* charge would under-count this one,
                // which is why the release is scope-checked (sv_release_charge).
                if (var_ty == TY_TENSOR_GPU && sc_budget_bytes >= 0) {
                    sv_release_charge(tname);
                    budget_charge(tname, val_nd, node);
                } else {
                    sv_set_bytes(tname, expr_bytes(val_nd));
                }
            }
        }
        if (tk == ND_FIELD_ACCESS) {
            let fname = nd_sv[target];
            sc_expr(nd_i2[target]); let obj_ty = sc_ty; let obj_sv_val = sc_sv;
            if (obj_ty == TY_STRUCT) {
                let st_idx = st_find(obj_sv_val);
                let fty = st_field_ty(st_idx, fname);
                if (fty == TY_UNKNOWN) {
                    sc_error_at(str_concat("no field '", str_concat(fname, str_concat("' on '", str_concat(obj_sv_val, "'")))), "");
                } else if (!ty_compat(val_ty, fty) && val_ty != TY_UNKNOWN) {
                    sc_error_at(str_concat("field assignment '", str_concat(fname, "'")),
                        str_concat(str_concat("field is ", ty_name(fty, "")),
                                   str_concat(", value is ", ty_name(val_ty, ""))));
                }
            }
        }
        if (tk == ND_INDEX) {
            sc_expr(nd_i2[target]);
            sc_expr(nd_i3[target]);
        }
        return 0;
    }

    if (k == ND_EXPR_STMT) { sc_expr(nd_i2[node]); return 0; }

    if (k == ND_RETURN) {
        let e = nd_i2[node];
        if (e == 0) {
            if (sc_cur_fn_ret_ty != TY_VOID && sc_cur_fn_ret_ty != TY_UNKNOWN) {
                sc_error_at(str_concat("return in '", str_concat(sc_cur_fn_name, "'")),
                    str_concat("function returns ", ty_name(sc_cur_fn_ret_ty, sc_cur_fn_ret_sv)));
            }
        } else {
            sc_expr(e);
            if (!ty_compat(sc_ty, sc_cur_fn_ret_ty) && sc_ty != TY_UNKNOWN && sc_cur_fn_ret_ty != TY_UNKNOWN) {
                sc_error_at(str_concat("return in '", str_concat(sc_cur_fn_name, "'")),
                    str_concat(str_concat("declared return ", ty_name(sc_cur_fn_ret_ty, sc_cur_fn_ret_sv)),
                               str_concat(", got ", ty_name(sc_ty, ""))));
            }
        }
        return 0;
    }

    if (k == ND_IF) {
        let cond_nd = nd_i2[node];
        let then_bl = nd_i3[node];
        let else_bl = nd_i4[node];
        sc_expr(cond_nd);
        if (sc_ty != TY_BOOL && sc_ty != TY_INT64 && sc_ty != TY_UNKNOWN) {
            sc_error_at("if condition", str_concat("expected bool/int64, got ", ty_name(sc_ty, "")));
        }
        sv_push_frame();
        sc_block_stmts(then_bl);
        sv_pop_frame();
        if (else_bl != 0) {
            sv_push_frame();
            sc_block_stmts(else_bl);
            sv_pop_frame();
        }
        return 0;
    }

    if (k == ND_WHILE) {
        sc_expr(nd_i2[node]);
        if (sc_ty != TY_BOOL && sc_ty != TY_INT64 && sc_ty != TY_UNKNOWN) {
            sc_error_at("while condition", str_concat("expected bool/int64, got ", ty_name(sc_ty, "")));
        }
        sv_push_frame();
        sc_block_stmts(nd_i3[node]);
        sv_pop_frame();
        return 0;
    }

    if (k == ND_FOR) {
        let var_name = nd_sv[node];
        let start_nd = nd_i2[node];
        let end_nd   = nd_i3[node];
        let body_bl  = nd_i4[node];
        sc_expr(start_nd);
        if (sc_ty != TY_INT64 && sc_ty != TY_UNKNOWN) {
            sc_error_at("for range start", str_concat("expected int64, got ", ty_name(sc_ty, "")));
        }
        sc_expr(end_nd);
        if (sc_ty != TY_INT64 && sc_ty != TY_UNKNOWN) {
            sc_error_at("for range end", str_concat("expected int64, got ", ty_name(sc_ty, "")));
        }
        sv_push_frame();
        sv_declare(var_name, TY_INT64, "", 0);
        sc_block_stmts(body_bl);
        sv_pop_frame();
        return 0;
    }

    if (k == ND_GPU_BLOCK) {
        // Save/restore so a gpu { } nested inside an @gpu fn does not drop the
        // enclosing function's GPU context on exit.
        let saved_gpu     = sc_in_gpu_block;
        let saved_budget  = sc_budget_bytes;
        let saved_used    = sc_used_bytes;
        // The un-sized counters belong to the scope too. Without restoring them
        // the block's exempted values stay counted in the enclosing function,
        // which reports them a second time at its own close (one value, two
        // warnings naming the same line).
        let saved_unknown = sc_unknown_count;
        let saved_first   = sc_unknown_first;
        sc_in_gpu_block = 1;
        // A bare `gpu { }` has no fraction of its own, so it inherits the whole
        // declared pool.
        //
        // NOTE: nesting resets the running total rather than adding to the
        // enclosing scope's. A `gpu { }` inside an `@gpu(0.25) fn` therefore
        // checks its own locals against the whole pool, not the remaining
        // quarter, which under-counts. This is the conservative-for-the-user
        // direction (it can only let more through, never reject), and it
        // matches the fact that the block's own locals die at its `}`. Fixing
        // it properly needs the live-range analysis that stage D defers.
        budget_begin(0);
        sv_push_frame();
        sc_block_stmts(nd_i2[node]);
        sv_pop_frame();
        budget_end();
        sc_budget_bytes  = saved_budget;
        sc_used_bytes    = saved_used;
        sc_unknown_count = saved_unknown;
        sc_unknown_first = saved_first;
        sc_in_gpu_block = saved_gpu;
        return 0;
    }

    if (k == ND_BREAK || k == ND_CONTINUE) { return 0; }
    if (k == ND_IMPORT_STMT) { return 0; }

    return 0;
}

// ── sc_fn: check one function definition ──────────────────────────────────────
fn sc_fn(int64 fn_node) -> int64 {
    let name        = nd_sv[fn_node];
    let params_list = nd_i2[fn_node];
    let ret_ty_nd   = nd_i3[fn_node];
    let body_list   = nd_i4[fn_node];

    mut ret_ty = TY_VOID; mut ret_sv_val = "";
    if (ret_ty_nd != 0) { ret_ty = node_ty_to_int(ret_ty_nd); ret_sv_val = node_ty_sv(ret_ty_nd); }

    // A leading @gpu on the fn header makes the whole body GPU context —
    // tensor@cpu references become errors and CPU-only I/O is banned, exactly
    // like a `gpu { ... }` block. @cpu / no annotation leave the body in CPU
    // context. The annotation node lives in the spare nd_i5 slot.
    let fn_hw      = nd_i5[fn_node];
    let fn_is_gpu  = hw_ann_is_gpu(fn_hw);
    let fn_is_cpu  = hw_ann_is_cpu(fn_hw);

    // A `@gpu(f)` / `@cpu(f)` fraction is a share of the declared pool. Validate
    // it where it is written — until B2 the parser read it and nothing used it.
    sc_check_hw_frac(fn_hw, hw_ann_name(fn_hw));

    let saved_fn   = sc_cur_fn_name;
    let saved_rty  = sc_cur_fn_ret_ty;
    let saved_rsv  = sc_cur_fn_ret_sv;
    let saved_gpu  = sc_in_gpu_block;
    // Stage B4: a @gpu fn body is a budgeted scope; its budget is the declared
    // pool scaled by the function's own fraction (or the whole pool if none).
    let saved_budget = sc_budget_bytes;
    let saved_used   = sc_used_bytes;
    if (fn_is_gpu) { budget_begin(fn_hw); }
    sc_cur_fn_name   = name;
    sc_cur_fn_ret_ty = ret_ty;
    sc_cur_fn_ret_sv = ret_sv_val;
    if (fn_is_gpu) { sc_in_gpu_block = 1; }

    // Push enclosing-fn diagnostic context so errors inside this body
    // show "    in fn name(...) -> ret_ty {" above the source line.
    // Note: parse_fn stores the fn keyword's line in nd_iv (the intent-value
    // slot) because by the time new_node runs, g_cur_line has advanced past
    // the body. nd_line at the FN_DEF node points to the end of the header.
    let fn_line  = nd_iv[fn_node];
    let fn_label = diag_extract_line(g_source, diag_line_start(g_source, fn_line));
    sc_ctx_push_fn(fn_line, fn_label);

    sv_push_frame();
    mut pnode = params_list;
    while (pnode != 0) {
        let param = nd_i2[pnode];
        let pname = nd_sv[param];
        let pty   = node_ty_to_int(nd_i2[param]);
        let ptsv  = node_ty_val_sv(nd_i2[param]);
        // A per-parameter placement that contradicts the function's placement
        // can never be satisfied at any call site — reject it outright.
        let p_hw = nd_i4[param];
        if (fn_is_gpu && hw_ann_is_cpu(p_hw)) {
            sc_active_node = param;
            sc_error_at(str_concat("@gpu fn '", str_concat(name, "'")),
                str_concat("parameter '", str_concat(pname, "' is annotated @cpu (remove one annotation)")));
        }
        if (fn_is_cpu && hw_ann_is_gpu(p_hw)) {
            sc_active_node = param;
            sc_error_at(str_concat("@cpu fn '", str_concat(name, "'")),
                str_concat("parameter '", str_concat(pname, "' is annotated @gpu (remove one annotation)")));
        }
        sv_declare(pname, pty, ptsv, 0);
        pnode = nd_i3[pnode];
    }
    sc_block_stmts(body_list);
    sv_pop_frame();

    // Report un-sized GPU locals while the scope's budget is still installed and
    // the fn context is still on the diagnostic stack, so the warning carries
    // "    in fn ..." and the right line.
    if (fn_is_gpu) { budget_end(); }

    sc_ctx_pop_fn();
    sc_cur_fn_name   = saved_fn;
    sc_cur_fn_ret_ty = saved_rty;
    sc_cur_fn_ret_sv = saved_rsv;
    sc_in_gpu_block  = saved_gpu;
    sc_budget_bytes  = saved_budget;
    sc_used_bytes    = saved_used;
    return 0;
}

// ── sc_program: full semantic pass over a parsed program ──────────────────────
// Find the top-level pool declaration (see the Memory-pool budget block above).
//
// The declaration is an ordinary `let` whose *name* the checker recognises, so
// it needs no new syntax and remains a perfectly normal global at runtime. It is
// scanned before any function body is checked, because `@gpu(f)` means "f of the
// declared pool" and there is no meaningful answer to that until the pool size
// is known.
fn pool_scan_toplevel(int64 top_list) -> int64 {
    mut snode = top_list;
    while (snode != 0) {
        let stmt = nd_i2[snode];
        if (nd_kind[stmt] == ND_LET) {
            if (str_eq(nd_sv[stmt], POOL_DECL_NAME)) {
                pool_decl_count = pool_decl_count + 1;
                sc_active_node = stmt;
                if (pool_decl_count > 1) {
                    sc_error_at("duplicate pool declaration",
                        str_concat(str_concat("'", POOL_DECL_NAME),
                                   "' is a deployment fact — declare it once"));
                } else {
                    let init_nd = nd_i3[stmt];
                    if (nd_kind[init_nd] != ND_INT) {
                        sc_error_at("pool declaration", str_concat(str_concat("'", POOL_DECL_NAME),
                            "' must be a plain byte count, e.g. `let vram = 25769803776;`"));
                    } else if (nd_iv[init_nd] <= 0) {
                        sc_error_at("pool declaration", str_concat(str_concat("'", POOL_DECL_NAME),
                            str_concat("' must be positive, got ", int64_to_str(nd_iv[init_nd]))));
                    } else {
                        pool_vram_bytes = nd_iv[init_nd];
                    }
                }
            }
        }
        snode = nd_i3[snode];
    }
    return 0;
}

// Validate a `@gpu(f)` / `@cpu(f)` fraction where it is written.
//
// `@gpu(0.5)` used to be parsed and then discarded, which made it a claim the
// compiler never looked at. Giving it a meaning starts with rejecting the values
// that cannot have one: a share that is zero, above the whole pool, or a
// fraction of a pool the program never declared.
fn sc_check_hw_frac(int64 hw_node, string what) -> int64 {
    let fb = hw_frac_bits(hw_node);
    if (fb == -1) { return 0; }
    sc_active_node = hw_node;
    if (!hw_frac_is_valid(fb)) {
        sc_error_at(str_concat(what, " fraction"),
            str_concat(str_concat("must be greater than 0 and at most 1, got ", nd_sv[hw_node]),
                       " (a share of the accelerator pool, e.g. @gpu(0.25))"));
        return 0;
    }
    if (pool_vram_bytes <= 0) {
        sc_error_at(str_concat(what, " fraction"),
            str_concat(str_concat("is a share of the accelerator pool, but no pool is declared; add a top-level `let ",
                                  POOL_DECL_NAME),
                       " = <bytes>;`"));
    }
    return 0;
}

fn sc_program(int64 structs_list, int64 fns_list, int64 top_list) -> int64 {
    pre_pass_structs(structs_list);
    pre_pass_fns(fns_list);
    register_builtins();
    pool_scan_toplevel(top_list);

    // Pre-declare top-level globals so functions that reference them work.
    mut snode = top_list;
    while (snode != 0) {
        let stmt = nd_i2[snode];
        if (nd_kind[stmt] == ND_LET) {
            let gname    = nd_sv[stmt];
            let mut_flag = nd_iv[stmt];
            let ty_ann   = nd_i2[stmt];
            let init_nd  = nd_i3[stmt];
            mut decl_ty = TY_UNKNOWN;
            mut decl_sv_val = "";
            if (ty_ann != 0) {
                decl_ty = node_ty_to_int(ty_ann);
                decl_sv_val = node_ty_val_sv(ty_ann);
            } else {
                let ik = nd_kind[init_nd];
                if (ik == ND_INT || ik == ND_BOOL)   { decl_ty = TY_INT64; }
                if (ik == ND_FLOAT)                  { decl_ty = TY_FLOAT64; }
                if (ik == ND_STR)                    { decl_ty = TY_STR; }
                if (ik == ND_ARRAY_LIT)              { decl_ty = TY_ARRAY; decl_sv_val = elem_sv(array_lit_elem_ty(init_nd)); }
                if (ik == ND_STRUCT_LIT)             { decl_ty = TY_STRUCT; decl_sv_val = nd_sv[init_nd]; }
            }
            sv_declare(gname, decl_ty, decl_sv_val, mut_flag);
        }
        snode = nd_i3[snode];
    }

    mut fnode = fns_list;
    while (fnode != 0) {
        sc_fn(nd_i2[fnode]);
        fnode = nd_i3[fnode];
    }

    sc_cur_fn_name   = "<top-level>";
    sc_cur_fn_ret_ty = TY_UNKNOWN;
    sc_cur_fn_ret_sv = "";
    snode = top_list;
    while (snode != 0) {
        sc_stmt(nd_i2[snode]);
        snode = nd_i3[snode];
    }

    return 0;
}
