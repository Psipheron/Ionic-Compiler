// ── Main driver ──────────────────────────────────────────────────────────────
import "imports.ionic";            // imp_* import resolver, g_parts fragments
import "parser/parser.ionic";      // Parser, parse_program, g_parse_error_count
import "semantic/checker.ionic";   // sc_program, sc_error_count
import "opt/opt.ionic";            // opt_program
import "codegen/elf.ionic";        // codegen_program (native), write_elf

mut ai        = 0;
mut src_str   = "";
mut out_name  = "a.out";
mut src_path  = "<source>";   // populated when a file argument is given
mut entry_path = "";          // first source file — seeds relative-import dir
mut target_triple = "";       // --target value; "" means "the host"
mut target_known  = 1;        // cleared when --target names a triple we can't emit
mut print_link    = 0;        // --print-link: show the link command, don't run it

mut cur_arg = get_arg(ai);
while (!str_eq(cur_arg, "")) {
    if (str_eq(cur_arg, "-o")) {
        ai = ai + 1;
        out_name = get_arg(ai);
    } else if (str_eq(cur_arg, "--target")) {
        ai = ai + 1;
        target_triple = get_arg(ai);
    } else if (str_eq(cur_arg, "--print-link")) {
        print_link = 1;
    } else {
        // A named source file that is not there is a hard error. `file_read`
        // returns an empty string for a missing path, so without this check the
        // file was silently treated as an empty program: the compile "succeeded"
        // and produced a stub object with no main body, and the only symptom was
        // that the program did nothing. `ionic nosuch.ionic -o x` exited 0.
        if (file_size(cur_arg) < 0) {
            println(str_concat("ionic: cannot read '", str_concat(cur_arg, "'")));
            println("  no such file, or not a regular file");
            exit(1);
        }
        let content = file_read(cur_arg);
        src_str = str_concat(src_str, str_concat(content, "\n"));
        src_path = cur_arg;
        if (str_eq(entry_path, "")) { entry_path = cur_arg; }
    }
    ai = ai + 1;
    cur_arg = get_arg(ai);
}

// Resolve --target into the codegen's object-format switch.
//
// The host is the default, so an unqualified `ionic foo.ionic` behaves exactly
// as it always has. Naming a different triple selects the other emitter, which
// makes it possible to build a Linux binary without sitting on a Linux box —
// the point of an edge deployment target.
//
// Note this is a *cross-compile*: the host cannot link the result, because
// linking needs a C compiler and that target's libc. When cross-compiling we
// therefore stop after writing the object file and print the exact commands to
// run on the target machine.
let host_linux = target_is_linux();
mut want_linux = host_linux;
if (str_len(target_triple) > 0) {
    if (str_eq(target_triple, "aarch64-linux") ||
        str_eq(target_triple, "aarch64-unknown-linux-gnu") ||
        str_eq(target_triple, "aarch64-linux-gnu") ||
        str_eq(target_triple, "linux")) {
        want_linux = 1;
    } else if (str_eq(target_triple, "aarch64-macos") ||
               str_eq(target_triple, "aarch64-apple-darwin") ||
               str_eq(target_triple, "macos")) {
        want_linux = 0;
    } else {
        target_known = 0;
    }
}

if (target_known == 0) {
    println(str_concat("ionic: unknown --target '", str_concat(target_triple, "'")));
    println("  supported: aarch64-linux (aarch64-unknown-linux-gnu), aarch64-macos (aarch64-apple-darwin)");
    exit(1);
}

// Emitting for a platform other than the one we are running on.
mut cross_compiling = 0;
if (want_linux != host_linux) { cross_compiling = 1; }

// Expand `import` statements: splice in transitively imported library modules
// and strip the import lines. g_parts holds fragments in dependency order.
// Seed the import directory from the entry file so `import "..."` paths
// resolve relative to where the source lives, not the process CWD.
imp_reset();
if (!str_eq(entry_path, "")) { g_imp_dir = imp_dir_of(entry_path); }
imp_expand(src_str);
mut combined = "";
mut pi = 1;
while (pi <= g_part_cnt) {
    combined = str_concat(combined, str_concat(g_parts[pi], "\n"));
    pi = pi + 1;
}
src_str = combined;

g_source = src_str;
g_source_path = src_path;

let ntoks = lex_global(src_str);
mut p = Parser { pos: 1 };
let prog = parse_program(p);

if (g_parse_error_count != 0) {
    println(str_concat(int64_to_str(g_parse_error_count), " parse error(s) found."));
    print_editor_hint();
    exit(1);
}

let structs_list = prog[1];
let fns_list     = prog[2];
let top_list     = prog[3];

sc_program(structs_list, fns_list, top_list);

if (sc_error_count != 0) {
    println(str_concat(int64_to_str(sc_error_count), " error(s) found."));
    print_editor_hint();
    exit(1);
}

opt_program(fns_list, top_list);

// Object file path is derived from the OUTPUT name, not a fixed /tmp path.
// A fixed path is not concurrency-safe: two `ionic` invocations at once would
// write the same object and each process would link a mixture of the two, so
// the emitted binary silently gets the wrong code. Keys on -o are unique per
// intended output, so parallel builds stay isolated. Placed next to the output
// (and kept as `<out>.o` in the cwd when -o has no directory), which also makes
// the --verify-self-hosting recipe predictable.
mut obj_path = str_concat(out_name, ".o");
g_target_linux = want_linux;
codegen_program(structs_list, fns_list, top_list, obj_path);

// Locate the C runtime (`ionic_model_runtime.c`) relative to the compiler's
// own installation root ($IONIC_ROOT, published by the C runtime at startup),
// so a tarball-/brew-installed `ionic` works from any CWD. Falls back to the
// repo-relative "src/ionic_model_runtime.c" for a source checkout.
mut rt_src = "src/ionic_model_runtime.c";
let ionic_root = getenv("IONIC_ROOT");
if (str_len(ionic_root) > 0) {
    let rt_try = str_concat(ionic_root, "/src/ionic_model_runtime.c");
    if (str_len(file_read(rt_try)) > 0) { rt_src = rt_try; }
}

// ── Cross-compile: stop at the object file ───────────────────────────────────
//
// We just emitted an object for a platform we are not running on, so we cannot
// link it here: linking needs a C compiler targeting that platform plus its
// libc and any backend libraries. Rather than invoke the host linker and let it
// fail with something cryptic, print the commands that will work on the target.
if (cross_compiling == 1) {
    println(str_concat("ionic: emitted ", str_concat(obj_path, " for aarch64-linux")));
    println("");
    println("This object cannot be linked on this machine. Copy it, the runtime,");
    println("and any backend libraries to the target, then link there:");
    println("");
    println(str_concat("  clang ", str_concat(obj_path,
        str_concat(" ", str_concat(rt_src, str_concat(" -o ", str_concat(out_name, " -lm")))))));
    println("");
    println("Add -DIONIC_HAVE_ORT -I<dir> -L<dir> -lonnxruntime at that link if the");
    println("program uses ONNX inference. Backend discovery runs on the machine");
    println("that links, not the one that compiles.");
    exit(0);
}

mut link_cmd = "";
if (g_target_linux == 1) {
    // -lm: glibc splits libm out of libc for sqrt/pow/floor/ceil/sin/... so the
    // runtime's math helpers need an explicit link on Linux. (macOS folds libm
    // into libSystem, so no flag is needed there.)
    link_cmd = str_concat("clang ", str_concat(obj_path, str_concat(str_concat(" ", rt_src), str_concat(" -o ", str_concat(out_name, " -lm")))));
} else {
    link_cmd = str_concat("clang -mmacosx-version-min=13.0 ", str_concat(obj_path, str_concat(str_concat(" ", rt_src), str_concat(" -o ", out_name))));
}

// ── Optional ML backend linkage ──────────────────────────────────────────────
//
// The runtime (`ionic_model_runtime.c`) compiles every backend behind an
// IONIC_HAVE_* macro. Without the matching -D and -I, those blocks vanish and
// `load_model` / `piper_forward` / `mlx_*` all report "not compiled in" at
// runtime — which is what used to happen for *every* backend, because this
// driver never passed any flags. Probing here fixes that.
//
// Detection is opportunistic: whatever is installed gets enabled, and a
// missing library is not an error. That keeps the tarball usable on a machine
// with no brew packages at all, while an `mlx-c` / `onnxruntime` install
// silently lights up the corresponding backend.
//
// IONIC_MLX_INCLUDE / IONIC_MLX_LIB (and the _ORT_ equivalents) override
// detection for non-Homebrew prefixes. IONIC_NO_MLX=1 forces MLX off, which is
// useful when a half-installed mlx-c would otherwise fail the link.
// Backends are linked only when the program actually references them. Linking
// unconditionally would make every Ionic binary (including hello-world) depend
// on mlx/onnx and pay their load + init cost at startup, so usage is detected
// from the source text first. False positives merely cost a link flag; false
// negatives would silently disable a backend, so the token lists below are the
// *shortest unambiguous prefix* for each entry point.
mut uses_mlx = 0;
mut uses_ort = 0;
if (str_contains(src_str, "mlx_") == 1)          { uses_mlx = 1; }
if (str_contains(src_str, "piper_forward") == 1) { uses_ort = 1; }
// `load_model` dispatches on the file extension at runtime; ONNX is the only
// backend with a loader. model_forward is ONNX too.
if (str_contains(src_str, "load_model") == 1)    { uses_ort = 1; }
if (str_contains(src_str, "model_forward") == 1) { uses_ort = 1; }

mut backend_defs = "";
mut backend_libs = "";
if (uses_mlx == 1 && g_target_linux == 0) {
    if (str_eq(getenv("IONIC_NO_MLX"), "") || str_eq(getenv("IONIC_NO_MLX"), "0")) {
        let mlx_inc = find_mlx_include();
        let mlx_lib = find_mlx_lib();
        if (!str_eq(mlx_inc, "") && !str_eq(mlx_lib, "")) {
            // -D + -I at compile time; -L + -l at link time. libmlxc records its
            // own dependencies by absolute path, so no -Wl,-rpath is needed.
            backend_defs = str_concat(" -DIONIC_HAVE_MLX -I", mlx_inc);
            backend_libs = str_concat(backend_libs, str_concat(" -L", str_concat(mlx_lib, " -lmlxc")));
        }
    }
}

// ONNX Runtime is the only model-loader backend, and it is probed regardless of
// target: on Linux it is the only ML path at all.
if (uses_ort == 1) {
    let ort_inc = find_ort_include();
    let ort_lib = find_ort_lib();
    if (!str_eq(ort_inc, "") && !str_eq(ort_lib, "")) {
        backend_defs = str_concat(backend_defs, str_concat(" -DIONIC_HAVE_ORT -I", ort_inc));
        backend_libs = str_concat(backend_libs, str_concat(" -L", str_concat(ort_lib, " -lonnxruntime")));
    }
}

if (str_len(backend_defs) > 0) {
    link_cmd = str_concat(link_cmd, backend_defs);
}
if (str_len(backend_libs) > 0) {
    link_cmd = str_concat(link_cmd, backend_libs);
}

// --print-link: emit the command and stop, so a CI job can assert what a build
// would have linked against (e.g. that a plain program links no backends).
if (print_link == 1) {
    println(link_cmd);
    exit(0);
}

// Propagate the linker's exit status.
//
// `system()` returns the wait status from waitpid(2), not the child's exit
// code: a normal exit is `code << 8`, so exit 1 arrives here as 256, and a
// signal death is the raw signal number in the low bits. Discarding that value
// made a failed link indistinguishable from a successful one — the compiler
// printed whatever the linker said to stderr and then exited 0, so
// `./ionic foo.ionic -o /typo/x` (a missing library, a full disk) looked like a
// successful build to every script and CI step that checked the exit code.
//
// clang has already printed the real diagnosis to stderr by this point; all
// that is left is to not claim success.
let link_status = system(link_cmd);
if (link_status != 0) {
    mut link_detail = "signal";
    if ((link_status & 127) == 0) {
        // Normal exit: recover the child's own code from the high byte.
        link_detail = str_concat("exit ", int64_to_str(link_status >> 8));
    }
    println(str_concat("ionic: link failed (", str_concat(link_detail, ")")));
    println(str_concat("  command: ", link_cmd));
    println("  Add --print-link to see the command without running it.");
    exit(1);
}

// ── Optional-backend discovery ───────────────────────────────────────────────
//
// Probes are `file_size` and `getenv`, never `system("test -f ...")`: paths are
// not interpolated into a shell command, so spaces and quoting cannot break
// detection, and no subprocess is spawned per candidate.
//
// `file_size` rather than `file_read`: existence checks used to call
// file_read() and test for a non-empty string, which mallocs the entire file.
// On a shared library that is tens to hundreds of megabytes allocated and
// leaked (Ionic strings are never freed) on every probe, of which there are
// several dozen per compile. file_size() is a single stat(2) and allocates
// nothing.

// A regular file exists. file_size() returns -1 for a missing path or a
// non-regular file, and >= 0 for a real one — including an empty file, which is
// why this is >= 0 and not > 0.
fn file_present(string path) -> int64 {
    if (file_size(path) >= 0) { return 1; }
    return 0;
}

// First candidate directory containing `rel`. `""` when none match, so callers
// can treat a miss as "backend unavailable" rather than an error.
fn probe_dir(string env_name, [string] candidates, int64 n, string rel) -> string {
    let env = getenv(env_name);
    if (str_len(env) > 0 && file_present(str_concat(env, str_concat("/", rel))) == 1) {
        return env;
    }
    mut i = 0;
    while (i < n) {
        let dir = candidates[i];
        if (file_present(str_concat(dir, str_concat("/", rel))) == 1) { return dir; }
        i = i + 1;
    }
    return "";
}

// First directory containing ANY of several alternative filenames.
// Platform-specific names (libmlxc.dylib vs libmlxc.so, libonnxruntime.dylib vs
// libonnxruntime.so) need this; a single fixed filename silently misses them.
//
// Iteration is directory-outer, filename-inner: every candidate name must be
// tried in the env override before falling through to the search path, or an
// override directory holding a differently-named library is skipped in favour
// of a system copy that has the name we happened to test first.
fn probe_dir_any(string env_name, [string] candidates, int64 n, [string] names, int64 nn) -> string {
    let env = getenv(env_name);
    if (str_len(env) > 0) {
        mut k0 = 0;
        while (k0 < nn) {
            if (file_present(str_concat(env, str_concat("/", names[k0]))) == 1) { return env; }
            k0 = k0 + 1;
        }
    }
    mut i = 0;
    while (i < n) {
        let dir = candidates[i];
        mut k = 0;
        while (k < nn) {
            if (file_present(str_concat(dir, str_concat("/", names[k]))) == 1) { return dir; }
            k = k + 1;
        }
        i = i + 1;
    }
    return "";
}

// Directories searched first for headers: the Homebrew prefix (Apple silicon),
// the Intel Homebrew / manual-install prefix, then the standard Unix system
// locations. /usr/include is where Debian/Ubuntu put distro-packaged headers,
// and it is the path that used to be missing, which made backend detection fail
// on exactly the platform this compiler targets.
fn include_dirs() -> [string] {
    mut c = [""];
    arr_reset(c);
    push(c, "/opt/homebrew/include");
    push(c, "/usr/local/include");
    push(c, "/usr/include");
    return c;
}

// Library search roots. aarch64-linux-gnu is Debian/Ubuntu's multiarch libdir;
// /usr/lib64 is Fedora/openSUSE; /usr/lib is generic Unix.
fn lib_dirs() -> [string] {
    mut c = [""];
    arr_reset(c);
    push(c, "/opt/homebrew/lib");
    push(c, "/usr/local/lib");
    push(c, "/usr/lib/aarch64-linux-gnu");
    push(c, "/usr/lib64");
    push(c, "/usr/lib");
    return c;
}

fn include_dir_count() -> int64 { return 3; }
fn lib_dir_count()     -> int64 { return 5; }

// ── MLX (Apple silicon only) ──────────────────────────────────────────────────
// Headers live under <prefix>/mlx/c/, so the include root is the prefix itself
// (not the mlx/ directory) — `#include "mlx/c/mlx.h"` needs that.
fn find_mlx_include() -> string {
    return probe_dir("IONIC_MLX_INCLUDE", include_dirs(), include_dir_count(), "mlx/c/mlx.h");
}

fn find_mlx_lib() -> string {
    mut names = [""];
    arr_reset(names);
    push(names, "libmlxc.dylib");
    push(names, "libmlxc.so");
    return probe_dir_any("IONIC_MLX_LIB", lib_dirs(), lib_dir_count(), names, 2);
}

// ── ONNX Runtime ─────────────────────────────────────────────────────────────
// Two layouts exist: <prefix>/include/onnxruntime/onnxruntime_c_api.h (brew) and
// <prefix>/include/onnxruntime_c_api.h (a manual install from the release zip).
// Try the nested form first, then the flat one.
fn find_ort_include() -> string {
    mut c = [""];
    arr_reset(c);
    push(c, "/opt/homebrew/include/onnxruntime");
    push(c, "/usr/local/include/onnxruntime");
    push(c, "/usr/include/onnxruntime");
    push(c, "/opt/homebrew/include");
    push(c, "/usr/local/include");
    push(c, "/usr/include");
    return probe_dir("IONIC_ORT_INCLUDE", c, 6, "onnxruntime_c_api.h");
}

fn find_ort_lib() -> string {
    mut names = [""];
    arr_reset(names);
    push(names, "libonnxruntime.dylib");
    push(names, "libonnxruntime.so");
    return probe_dir_any("IONIC_ORT_LIB", lib_dirs(), lib_dir_count(), names, 2);
}


