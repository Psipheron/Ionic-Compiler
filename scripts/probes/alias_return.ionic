// An array alias returned from a function.
//
// The copy `let b = a` makes two names over one header. Without a retain the
// exit block releases `a` while the caller still holds `b`, so the caller reads
// freed memory — a use-after-free, not a leak.
//
// Expected: 3 / 1 / 3

fn make() -> [int64] {
    let a = [1, 2, 3];
    let b = a;
    return b;
}

fn main() {
    let x = make();
    println(x.len);
    println(x[0]);
    println(x[2]);
}
