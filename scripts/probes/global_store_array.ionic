// An array stored into a global.
//
// `g = a` puts the pointer in the global. The local's claim must be dropped:
// the global is still live after the function returns, so the local must not
// release the array out from under it.
//
// Expected: 1 / 3

mut g = [0];

fn setup() {
    let a = [1, 2, 3];
    g = a;
}

fn main() {
    setup();
    println(g[0]);
    println(g[2]);
}
