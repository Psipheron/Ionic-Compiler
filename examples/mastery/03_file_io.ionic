// Mastery 03.4 — file_write / file_read round trip.
//
// The write returns a status: 0 on success, -1 when the file cannot be opened.
// `file_exists` is a builtin here too, and means "a regular file is here" — a
// directory is false and an empty file is true. `file_read` returns "" for both a
// missing file and an empty one, so the two are only distinguishable by asking
// `file_exists` as well. scripts/io_check.sh pins all of this down.

let path = "/tmp/ionic_mastery_io.txt";
let payload = "round-trip payload 123\n";

let st = file_write(path, payload);
println(str_concat("write status: ", int64_to_str(st)));
println(str_concat("exists:       ", int64_to_str(file_exists(path))));

let back = file_read(path);
println(str_concat("wrote:    ", payload));
println(str_concat("read back:", back));
println(str_concat("equal?    ", int64_to_str(str_eq(back, payload))));

// Missing files read as "" rather than erroring — the same "" an empty file
// produces, which is why the existence probe is worth having.
let missing = file_read("/tmp/ionic_no_such_file");
println(str_concat("missing file len = ", int64_to_str(str_len(missing))));
println(str_concat("missing exists?   = ", int64_to_str(file_exists("/tmp/ionic_no_such_file"))));
