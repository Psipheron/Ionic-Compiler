// Mastery 00.4 — the "known discrepancies" from docs/mastery/README.md, reproduced.
//
// Run:
//   ./ionic_new examples/mastery/00_discrepancies.ionic -o /tmp/d && /tmp/d
//
// You will see:
//   1. mean_f([1,2,3,4]) = 3   (WRONG; a correct mean is 2.5) — the std.data
//      off-by-one, because those helpers assume 1-based arrays while Ionic
//      arrays are 0-based. Still open.
//   2. println(names[0]) prints "alice". This one used to be a discrepancy and
//      is now FIXED: dispatch asks the codegen type oracle (ncg_ty_of) instead
//      of guessing from the shape of the AST node.
//
// (Discrepancy 3 — CLI/`--run` — is about the tooling, not output. Discrepancy
//  4 — print vs println — is shown in 01_print_variants.ionic.)

import std.data.*;

mut names = ["alice", "bob"];

let a = [1.0, 2.0, 3.0, 4.0];
println(str_concat("mean_f([1,2,3,4]) = ", float64_to_str(mean_f(a))));
println("   (correct answer is 2.5; std.data drops index 0)");

// Discrepancy 2, formerly a bug: this printed the element's pointer as an
// integer. It now prints the string. See examples/mastery/02_string_array_print.ionic
// for the parameter and return-value cases too.
println(str_concat("names[0] = ", names[0]));

// For contrast, indexing into an [int64] also prints correctly:
mut nums = [10, 20, 30];
println(str_concat("nums[0] (int array) = ", int64_to_str(nums[0])));

// Bounds checking (discrepancy 1b): uncomment to see the runtime abort.
// println(str_concat("OOB: ", int64_to_str(nums[3])));
